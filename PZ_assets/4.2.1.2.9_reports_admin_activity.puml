@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam ArrowColor Black
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
  StartColor Black
  EndColor Black
}

title Алгоритм действий по аналитике и администрированию

start
partition "Администратор" {
  :Открывает раздел отчетов, клиентов, персонала или лояльности;
}
partition "WPF-приложение" {
  :Запрашивает управленческие данные;
}
partition "API Garden Nook" {
  :Формирует списки, агрегаты продаж и складские показатели;
}
partition "Администратор" {
  if (Нужен отчет?) then (да)
    :Выбирает период и просматривает показатели;
  else (нет)
    :Создает или изменяет клиента, сотрудника, скидку или категорию;
  endif
}
partition "WPF-приложение" {
  :Показывает таблицы, графики и формы редактирования;
  :Отправляет выбранную операцию на сервер;
}
partition "API Garden Nook" {
  :Проверяет права администратора;
  :Возвращает результат операции;
}
partition "WPF-приложение" {
  :Обновляет управленческий раздел;
}
stop
@enduml
