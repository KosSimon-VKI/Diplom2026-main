@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam ArrowColor Black
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
  StartColor Black
  EndColor Black
}

title Алгоритм действий по списанию и заготовкам

start
partition "Сотрудник" {
  :Открывает раздел заготовок или актов списания;
}
partition "WPF-приложение" {
  :Запрашивает задачи, полуфабрикаты и складские остатки;
}
partition "API Garden Nook" {
  :Возвращает производственные данные;
}
partition "Сотрудник" {
  if (Создается акт списания?) then (да)
    :Выбирает сырье или полуфабрикат;
    :Указывает количество и причину списания;
  else (нет)
    :Выбирает задачу заготовки;
    :Фиксирует выполненный объем;
  endif
}
partition "WPF-приложение" {
  :Проверяет корректность количества;
  :Отправляет результат операции;
}
partition "API Garden Nook" {
  :Создает документ или запись заготовки;
  :Корректирует фактические остатки;
}
partition "WPF-приложение" {
  :Обновляет список операций;
  :Показывает подтверждение выполнения;
}
stop
@enduml
