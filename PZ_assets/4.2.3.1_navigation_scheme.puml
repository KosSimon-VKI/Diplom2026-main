@startuml
left to right direction
skinparam shadowing false
skinparam monochrome true

rectangle "Веб-контур клиента" {
  [Авторизация] --> [Меню]
  [Регистрация] --> [Меню]
  [Меню] --> [Карточка позиции]
  [Карточка позиции] --> [Корзина]
  [Корзина] --> [Оформление заказа]
  [Оформление заказа] --> [Профиль]
  [Профиль] --> [История заказов]
}

rectangle "WPF-контур сотрудников" {
  [Вход сотрудника] --> [Главное окно]
  [Главное окно] --> [Очередь заказов]
  [Главное окно] --> [Меню и категории]
  [Главное окно] --> [Сырье и полуфабрикаты]
  [Главное окно] --> [Техкарты]
  [Главное окно] --> [Заготовки]
  [Главное окно] --> [Стоп-лист]
  [Главное окно] --> [Акты списания]
  [Главное окно] --> [Клиенты]
  [Главное окно] --> [Отчеты]
  [Главное окно] --> [Персонал]
}
@enduml
