@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam ArrowColor Black
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
  StartColor Black
  EndColor Black
}

title Алгоритм действий по обработке заказа сотрудником

start
partition "Сотрудник" {
  :Авторизуется в WPF-приложении;
  :Открывает раздел заказов;
}
partition "WPF-приложение" {
  :Запрашивает производственную очередь;
}
partition "API Garden Nook" {
  :Возвращает активные заказы;
}
partition "Сотрудник" {
  :Выбирает заказ;
  :Просматривает состав, комментарий и время самовывоза;
}
partition "WPF-приложение" {
  :Открывает детали заказа;
  :При необходимости запрашивает технологическую карту;
}
partition "API Garden Nook" {
  :Возвращает рецепт и технологию приготовления;
}
partition "Сотрудник" {
  :Отмечает готовность позиции;
}
partition "API Garden Nook" {
  if (Все позиции готовы?) then (да)
    :Переводит заказ в завершенный статус;
  else (нет)
    :Обновляет состояние отдельной позиции;
  endif
}
partition "WPF-приложение" {
  :Обновляет очередь заказов;
}
stop
@enduml
