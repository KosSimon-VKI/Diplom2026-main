@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam ArrowColor Black
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
  StartColor Black
  EndColor Black
}

title Алгоритм действий по работе с технологическими картами

start
partition "Сотрудник" {
  :Открывает раздел технологических карт;
}
partition "WPF-приложение" {
  :Запрашивает список технологических карт;
}
partition "API Garden Nook" {
  :Возвращает рецептуры, состав и технологию приготовления;
}
partition "Сотрудник" {
  :Открывает нужную технологическую карту;
  if (Роль администратора?) then (да)
    :Редактирует название, состав и этапы приготовления;
  else (нет)
    :Использует карту только для просмотра;
    stop
  endif
}
partition "WPF-приложение" {
  :Проверяет состав и единицы измерения;
  :Отправляет изменения на сервер;
}
partition "API Garden Nook" {
  :Пересчитывает массу, КБЖУ и себестоимость;
  :Сохраняет состав карты;
}
partition "WPF-приложение" {
  :Обновляет список и карточку рецептуры;
}
stop
@enduml
