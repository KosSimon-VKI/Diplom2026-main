@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam ArrowColor Black
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
  StartColor Black
  EndColor Black
}

title Алгоритм действий по управлению складом и стоп-листом

start
partition "Администратор" {
  :Открывает склад или стоп-лист;
}
partition "WPF-приложение" {
  :Загружает сырье, полуфабрикаты и недоступные позиции;
}
partition "API Garden Nook" {
  :Возвращает остатки, единицы измерения и категории;
}
partition "Администратор" {
  if (Поступление сырья?) then (да)
    :Указывает ингредиент и количество поставки;
  else (нет)
    :Выбирает позицию для стоп-листа или редактирования;
  endif
}
partition "WPF-приложение" {
  :Проверяет количество и выбранные значения;
  :Отправляет операцию на сервер;
}
partition "API Garden Nook" {
  :Обновляет остатки или доступность позиции;
  :Проверяет влияние на меню;
}
partition "WPF-приложение" {
  :Перезагружает складские данные;
  :Показывает актуальное состояние;
}
stop
@enduml
