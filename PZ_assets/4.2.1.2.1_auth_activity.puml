@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam ArrowColor Black
skinparam activity {
  BackgroundColor White
  BorderColor Black
  FontColor Black
  DiamondBackgroundColor White
  DiamondBorderColor Black
  StartColor Black
  EndColor Black
}

title Алгоритм действий по авторизации пользователя

start
partition "Пользователь" {
  :Открывает форму входа;
  :Вводит логин/телефон и пароль;
  :Нажимает кнопку входа;
}
partition "Интерфейс" {
  :Проверяет заполненность полей;
  if (Поля заполнены?) then (да)
    :Формирует запрос авторизации;
  else (нет)
    :Подсвечивает незаполненные поля;
    stop
  endif
}
partition "API Garden Nook" {
  :Получает учетные данные;
  :Ищет пользователя в базе данных;
  if (Пользователь найден?) then (да)
    :Проверяет пароль и роль;
  else (нет)
    :Возвращает отказ авторизации;
    stop
  endif
}
partition "Интерфейс" {
  if (Авторизация успешна?) then (да)
    :Сохраняет cookie-сессию;
    :Открывает доступный раздел;
  else (нет)
    :Показывает сообщение об ошибке;
  endif
}
stop
@enduml
