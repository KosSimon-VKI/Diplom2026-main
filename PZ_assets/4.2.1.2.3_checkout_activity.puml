title Алгоритм действий по оформлению заказа клиентом

start
partition "Клиент" {
  :Добавляет позиции и добавки в корзину;
  :Переходит к оформлению заказа;
}
partition "Веб-интерфейс" {
  :Пересчитывает количество, КБЖУ и стоимость;
  :Запрашивает скидку клиента и слоты самовывоза;
}
partition "API Garden Nook" {
  :Возвращает данные профиля и доступные интервалы;
}
partition "Клиент" {
  :Выбирает тип заказа;
  :Указывает комментарий и время самовывоза;
  :Подтверждает заказ;
}
partition "Веб-интерфейс" {
  :Формирует DTO заказа;
}
partition "API Garden Nook" {
  :Проверяет состав заказа;
  :Проверяет остатки и доступность позиций;
  if (Заказ можно создать?) then (да)
    :Создает заказ со статусом;
    :Рассчитывает итоговую сумму и скидку;
  else (нет)
    :Возвращает конфликт доступности;
    stop
  endif
}
partition "Веб-интерфейс" {
  :Очищает корзину;
  :Показывает номер, статус и итог заказа;
}
stop
@enduml
