@startuml
title Алгоритм определения расчетного веса компонента технологической карты

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam ArrowColor black
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontColor black
  RoundCorner 10
}

rectangle "Получение\nтехнологической\nкарты" as A
rectangle "Загрузка состава:\nсырье и\nполуфабрикаты" as B
rectangle "Чтение весов\nGrossWeight,\nNetWeight,\nOutputWeight" as C
rectangle "Проверка:\nOutputWeight > 0?" as D
rectangle "Рабочий вес =\nOutputWeight" as E
rectangle "Проверка:\nNetWeight > 0?" as F
rectangle "Рабочий вес =\nNetWeight" as G
rectangle "Рабочий вес =\nGrossWeight" as H
rectangle "Перевод в\nбазовые единицы" as I
rectangle "Суммирование\nрасхода и выхода" as J
rectangle "Передача веса\nв меню,\nзаготовки и отчеты" as K

A --> B
B --> C
C --> D
D --> E : да
D --> F : нет
F --> G : да
F --> H : нет
E --> I
G --> I
H --> I
I --> J
J --> K

@enduml
