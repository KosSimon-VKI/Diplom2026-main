@startuml
title Алгоритм расчета складского отклонения

left to right direction

skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName "Times New Roman"
skinparam ArrowColor black
skinparam rectangle {
  BackgroundColor white
  BorderColor black
  FontColor black
  RoundCorner 10
}

rectangle "Получение\nпериода отчета" as A
rectangle "Загрузка заказов,\nсписаний, заготовок\nи остатков" as B
rectangle "Расход\nпо заказам" as C
rectangle "Расход\nпо списаниям" as D
rectangle "Расход\nпо заготовкам" as E
rectangle "Общий\nрасчетный расход" as F
rectangle "Фактический\nостаток и\nстоимость сырья" as G
rectangle "Отклонение:\nStockFact -\nRequired" as H
rectangle "Стоимостное\nотклонение:\nDelta * CostRub" as I
rectangle "Строка отчета\nдля администратора" as J

A --> B
B --> C
B --> D
B --> E
C --> F
D --> F
E --> F
F --> G
G --> H
H --> I
I --> J

@enduml
