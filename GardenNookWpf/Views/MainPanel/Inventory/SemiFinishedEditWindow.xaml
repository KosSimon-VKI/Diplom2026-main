<Window x:Class="GardenNookWpf.Views.MainPanel.Inventory.SemiFinishedEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Полуфабрикат"
        Width="860"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Margin="18,16,18,12">
                <StackPanel>
                    <Border Style="{StaticResource ModalCardBorder}" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.ColumnSpan="3">
                                <TextBlock Text="Название полуфабриката"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <TextBox x:Name="NameTextBox"
                                         Height="44"
                                         Margin="0,8,0,14"
                                         FontSize="18"
                                         MaxLength="255"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Себестоимость, ₽"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <TextBox x:Name="CostTextBox"
                                         Height="42"
                                         Margin="0,8,0,14"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Единица измерения"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <ComboBox x:Name="UnitComboBox"
                                          Height="42"
                                          Margin="0,8,0,14"
                                          FontSize="18"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Категория"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <ComboBox x:Name="CategoryComboBox"
                                          Height="42"
                                          Margin="0,8,0,0"
                                          FontSize="18"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Техкарта"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <TextBox x:Name="TechnicalCardSearchTextBox"
                                         Height="38"
                                         Margin="0,8,0,8"
                                         FontSize="17"
                                         VerticalContentAlignment="Center"
                                         TextChanged="TechnicalCardSearchTextBox_TextChanged"/>
                                <ComboBox x:Name="TechnicalCardComboBox"
                                          Height="42"
                                          Margin="0,0,0,0"
                                          FontSize="18"
                                          DisplayMemberPath="Name"
                                          SelectedValuePath="Id"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModalCardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="КБЖУ"
                                       Grid.ColumnSpan="5"
                                       FontSize="22"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       Margin="0,0,0,12"/>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Ккал"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <TextBox x:Name="CaloriesTextBox"
                                         Height="42"
                                         Margin="0,8,0,14"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Белки, г"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <TextBox x:Name="ProteinsTextBox"
                                         Height="42"
                                         Margin="0,8,0,14"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="4">
                                <TextBlock Text="Жиры, г"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <TextBox x:Name="FatsTextBox"
                                         Height="42"
                                         Margin="0,8,0,14"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Углеводы, г"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <TextBox x:Name="CarbsTextBox"
                                         Height="42"
                                         Margin="0,8,0,0"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Килоджоули"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                <TextBox x:Name="KilojoulesTextBox"
                                         Height="42"
                                         Margin="0,8,0,0"
                                         FontSize="18"
                                         VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="ValidationText"
                               Margin="0,12,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFB33131"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button x:Name="SaveButton"
                        Content="Сохранить"
                        Width="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
