<Window x:Class="GardenNookWpf.Views.MainPanel.Inventory.IngredientEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сырье"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,12">
                <Border Style="{StaticResource ModalCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.ColumnSpan="3">
                            <TextBlock Text="Название сырья"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorTextBrush}"/>
                            <TextBox x:Name="NameTextBox"
                                     Height="44"
                                     Margin="0,8,0,14"
                                     FontSize="18"
                                     MaxLength="255"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="Остаток"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorTextBrush}"/>
                            <TextBox x:Name="StockTextBox"
                                     Height="42"
                                     Margin="0,8,0,14"
                                     FontSize="18"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="2">
                            <TextBlock Text="Себестоимость, ₽"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorTextBrush}"/>
                            <TextBox x:Name="CostTextBox"
                                     Height="42"
                                     Margin="0,8,0,14"
                                     FontSize="18"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <TextBlock Text="Единица измерения"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorTextBrush}"/>
                            <ComboBox x:Name="UnitComboBox"
                                      Height="42"
                                      Margin="0,8,0,14"
                                      FontSize="18"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2">
                            <TextBlock Text="Категория"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorTextBrush}"/>
                            <ComboBox x:Name="CategoryComboBox"
                                      Height="42"
                                      Margin="0,8,0,14"
                                      FontSize="18"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"/>
                        </StackPanel>

                        <TextBlock x:Name="ValidationText"
                                   Grid.Row="5"
                                   Grid.ColumnSpan="3"
                                   Margin="0,10,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB33131"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button x:Name="SaveButton"
                        Content="Сохранить"
                        Width="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
