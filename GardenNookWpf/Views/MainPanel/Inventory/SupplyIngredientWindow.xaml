<Window x:Class="GardenNookWpf.Views.MainPanel.Inventory.SupplyIngredientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Поставка сырья"
        Width="1120"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Поставка сырья"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="0.9*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource ModalCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Сырье"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ModalColorTextBrush}"/>

                        <TextBox x:Name="IngredientSearchTextBox"
                                 Grid.Row="1"
                                 Height="42"
                                 Margin="0,12,0,12"
                                 FontSize="18"
                                 VerticalContentAlignment="Center"
                                 TextChanged="IngredientSearchTextBox_TextChanged"/>

                        <Grid Grid.Row="2">
                            <ScrollViewer x:Name="IngredientsScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,8,0">
                                <ItemsControl x:Name="IngredientsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,8"
                                                    Padding="10"
                                                    Background="{Binding CardBackground}"
                                                    BorderBrush="{Binding CardBorderBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8"
                                                    MouseLeftButtonUp="IngredientCard_MouseLeftButtonUp"
                                                    Cursor="Hand">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="20"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                   TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,3,0,0"/>
                                                        <TextBlock Text="{Binding StockDisplay}"
                                                                   FontSize="17"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,7,0,0"/>
                                                    </StackPanel>

                                                    <Button Grid.Column="1"
                                                            Content="{Binding AddButtonText}"
                                                            IsEnabled="{Binding CanAdd}"
                                                            Width="140"
                                                            Height="46"
                                                            Margin="14,0,0,0"
                                                            Padding="10,0"
                                                            FontSize="18"
                                                            VerticalContentAlignment="Center"
                                                            HorizontalContentAlignment="Center"
                                                            Style="{StaticResource ModalSecondaryButton}"
                                                            Tag="{Binding}"
                                                            Click="AddIngredientButton_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="EmptyIngredientsText"
                                       Text="Сырье не найдено."
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource ModalCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Выбрано"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ModalColorTextBrush}"/>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <ScrollViewer x:Name="SelectedScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Padding="0,0,8,0">
                                <ItemsControl x:Name="SelectedIngredientsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,0,10"
                                                    Padding="10"
                                                    Background="White"
                                                    BorderBrush="{StaticResource ModalColorPrimaryBrush}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="18"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding UnitDisplay}"
                                                                       FontSize="14"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                       Margin="0,3,0,0"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Content="Удалить"
                                                                Width="116"
                                                                Height="42"
                                                                Margin="8,0,0,0"
                                                                Padding="10,0"
                                                                FontSize="16"
                                                                VerticalContentAlignment="Center"
                                                                HorizontalContentAlignment="Center"
                                                                Background="#FF742C27"
                                                                Foreground="White"
                                                                Style="{StaticResource ModalSecondaryButton}"
                                                                Tag="{Binding}"
                                                                Click="RemoveSelectedButton_Click"/>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                        <TextBlock Text="Пришло"
                                                                   FontSize="15"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{StaticResource ModalColorTextBrush}"/>
                                                        <Border Margin="0,5,0,0"
                                                                Background="#FFF9F9F9"
                                                                BorderBrush="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                BorderThickness="1.5"
                                                                CornerRadius="8"
                                                                Padding="8,0">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                                         Height="38"
                                                                         FontSize="18"
                                                                         FontWeight="SemiBold"
                                                                         BorderThickness="0"
                                                                         Background="Transparent"
                                                                         VerticalContentAlignment="Center"/>
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding UnitName}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                           VerticalAlignment="Center"
                                                                           Margin="8,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock x:Name="EmptySelectedText"
                                       Text="Выберите сырье слева"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock x:Name="ValidationText"
                                   Grid.Row="2"
                                   Margin="0,12,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB33131"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="Добавить"
                        Width="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
