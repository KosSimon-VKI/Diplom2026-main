<Window x:Class="GardenNookWpf.Views.MainPanel.Inventory.ConfirmDeleteIngredientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление сырья"
        Width="680"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Удаление сырья"
                               Style="{StaticResource ModalHeaderTitle}"/>
                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,12">
                <Border Style="{StaticResource ModalCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Вы действительно хотите удалить сырье?"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ModalColorTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ItemNameText"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                        <TextBlock x:Name="DetailsText"
                                   FontSize="17"
                                   Foreground="{StaticResource ModalColorTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="Если сырье используется в техкартах, заказах или списаниях, сервер не позволит удалить его."
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FF742C27"
                                   TextWrapping="Wrap"
                                   Margin="0,14,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="Удалить"
                        Width="150"
                        Margin="0,0,10,0"
                        Background="#FF742C27"
                        Foreground="White"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Confirm_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
