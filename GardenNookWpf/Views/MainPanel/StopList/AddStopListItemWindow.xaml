<Window x:Class="GardenNookWpf.Views.MainPanel.StopList.AddStopListItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить позицию"
        Width="860"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Добавить позицию в стоп-лист"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="?"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Поиск:"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ModalColorTextBrush}"/>

                <TextBox x:Name="SearchTextBox"
                         Grid.Row="1"
                         Margin="0,8,0,12"
                         Height="46"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         TextChanged="SearchTextBox_TextChanged"/>

                <ListBox x:Name="PositionsListBox"
                         Grid.Row="2"
                         BorderBrush="{StaticResource ModalColorBorderBrush}"
                         BorderThickness="2"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="PositionsListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="8,6,14,6"
                                    Padding="10"
                                    Style="{StaticResource ModalCardBorder}"
                                    Background="{StaticResource ModalColorCardAltBrush}"
                                    HorizontalAlignment="Stretch">
                                <DockPanel LastChildFill="True">
                                    <TextBlock DockPanel.Dock="Right"
                                               Width="180"
                                               Text="{Binding StateText}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding StateBrush}"
                                               TextAlignment="Right"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>

                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ItemTypeDisplay}"
                                                   Margin="0,4,0,0"
                                                   FontSize="16"
                                                   Foreground="{StaticResource ModalColorTextBrush}"/>
                                        <TextBlock Text="{Binding CategoryDisplay}"
                                                   Margin="0,2,0,0"
                                                   FontSize="15"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   Visibility="{Binding CategoryVisibility}"/>
                                        <TextBlock Text="{Binding VolumeWeightDisplay}"
                                                   Margin="0,2,0,0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   Visibility="{Binding VolumeWeightVisibility}"/>
                                        <TextBlock Text="{Binding ExistingLimitDisplay}"
                                                   Margin="0,2,0,0"
                                                   FontSize="14"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   Visibility="{Binding ExistingLimitVisibility}"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="3"
                            Margin="0,12,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="Осталось порций:"
                               FontSize="19"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource ModalColorTextBrush}"/>
                    <TextBox x:Name="RemainingPortionsTextBox"
                             Width="150"
                             Height="42"
                             Margin="12,0,0,0"
                             FontSize="18"
                             VerticalContentAlignment="Center"
                             Text="0"/>
                </StackPanel>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="4"
                           Margin="0,10,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FFB33131"
                           Visibility="Collapsed"/>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button x:Name="AddButton"
                        Content="Добавить"
                        Width="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Add_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
