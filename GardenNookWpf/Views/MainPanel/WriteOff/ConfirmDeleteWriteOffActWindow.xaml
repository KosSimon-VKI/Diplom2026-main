<Window x:Class="GardenNookWpf.Views.MainPanel.WriteOff.ConfirmDeleteWriteOffActWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="РџРѕРґС‚РІРµСЂР¶РґРµРЅРёРµ СѓРґР°Р»РµРЅРёСЏ"
        Width="720"
        Height="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="РЈРґР°Р»РµРЅРёРµ Р°РєС‚Р° СЃРїРёСЃР°РЅРёСЏ"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="Г—"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,12">
                <Border Style="{StaticResource ModalCardBorder}">
                    <StackPanel>
                        <TextBlock Text="РЈРґР°Р»РёС‚СЊ Р°РєС‚ СЃРїРёСЃР°РЅРёСЏ Рё РІРµСЂРЅСѓС‚СЊ СЃРїРёСЃР°РЅРЅС‹Рµ РѕСЃС‚Р°С‚РєРё РЅР° СЃРєР»Р°Рґ?"
                                   Style="{StaticResource ModalBodyText}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="ActTitleText"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource ModalBodyText}"
                                   FontSize="19"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="РЈРґР°Р»РёС‚СЊ"
                        Width="180"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Confirm_Click"/>
                <Button Content="РћС‚РјРµРЅР°"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
