<Window x:Class="GardenNookWpf.Views.MainPanel.Menu.MenuCategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категория меню"
        Width="680"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,12">
                <Border Style="{StaticResource ModalCardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Название категории"
                                   FontSize="21"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModalColorTextBrush}"/>

                        <TextBox x:Name="NameTextBox"
                                 Grid.Row="1"
                                 Height="46"
                                 Margin="0,10,0,0"
                                 FontSize="20"
                                 MaxLength="50"
                                 VerticalContentAlignment="Center"/>

                        <TextBlock Text="До 50 символов. Название должно быть уникальным внутри выбранного типа."
                                   Grid.Row="2"
                                   FontSize="16"
                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <TextBlock x:Name="ValidationText"
                                   Grid.Row="3"
                                   Margin="0,14,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#FFB33131"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button x:Name="SaveButton"
                        Content="Сохранить"
                        Width="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
