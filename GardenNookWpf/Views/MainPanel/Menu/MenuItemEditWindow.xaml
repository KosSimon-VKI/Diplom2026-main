<Window x:Class="GardenNookWpf.Views.MainPanel.Menu.MenuItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Позиция меню"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="White"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="EditBlockTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ModalColorPrimaryDarkBrush}"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>

        <Style x:Key="EditLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ModalColorTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>

        <Style x:Key="EditTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="EditComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="BigEditCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ModalColorTextBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="30"
                                    Height="30"
                                    Background="White"
                                    BorderBrush="{StaticResource ModalColorBorderBrush}"
                                    BorderThickness="2"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark"
                                      Data="M 7 15 L 13 21 L 24 8"
                                      Stroke="{StaticResource ModalColorPrimaryDarkBrush}"
                                      StrokeThickness="4"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="Background" Value="#FFEDF1E5"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ModalColorPrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource ModalColorPrimaryBrush}"/>
                                <Setter TargetName="Box" Property="Background" Value="#FFF7F9F3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalShellBorder}" Margin="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="22">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}">
                        <StackPanel>
                            <TextBlock Text="Основное" Style="{StaticResource EditBlockTitle}"/>

                            <TextBlock Text="Тип позиции" Style="{StaticResource EditLabel}"/>
                            <TextBlock x:Name="TypeDisplayText"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                       Margin="0,0,0,18"/>

                            <TextBlock Text="Название" Style="{StaticResource EditLabel}"/>
                            <TextBox x:Name="NameTextBox"
                                     Style="{StaticResource EditTextBox}"
                                     MaxLength="255"/>

                            <TextBlock Text="Категория" Style="{StaticResource EditLabel}"/>
                            <ComboBox x:Name="CategoryComboBox"
                                      Style="{StaticResource EditComboBox}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"/>

                            <TextBlock Text="Единица измерения" Style="{StaticResource EditLabel}"/>
                            <ComboBox x:Name="UnitComboBox"
                                      Style="{StaticResource EditComboBox}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorCardBrush}">
                        <StackPanel>
                            <TextBlock Text="Цена и размер" Style="{StaticResource EditBlockTitle}"/>

                            <TextBlock Text="Цена, ₽" Style="{StaticResource EditLabel}"/>
                            <TextBox x:Name="PriceTextBox"
                                     Style="{StaticResource EditTextBox}"/>

                            <StackPanel x:Name="QuantityPanel">
                                <TextBlock Text="Количество" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="QuantityTextBox"
                                         Style="{StaticResource EditTextBox}"/>
                            </StackPanel>

                            <TextBlock Text="Доступность" Style="{StaticResource EditLabel}"/>
                            <CheckBox x:Name="IsAvailableCheckBox"
                                      Content="Позиция доступна в меню"
                                      Style="{StaticResource BigEditCheckBox}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorCardBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.ColumnSpan="3"
                                       Text="КБЖУ"
                                       Style="{StaticResource EditBlockTitle}"/>

                            <StackPanel Grid.Row="1" Grid.Column="0">
                                <TextBlock Text="Ккал" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="CaloriesTextBox" Style="{StaticResource EditTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="2">
                                <TextBlock Text="Килоджоули" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="KilojoulesTextBox" Style="{StaticResource EditTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0">
                                <TextBlock Text="Белки" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="ProteinsTextBox" Style="{StaticResource EditTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Text="Жиры" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="FatsTextBox" Style="{StaticResource EditTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0">
                                <TextBlock Text="Углеводы" Style="{StaticResource EditLabel}"/>
                                <TextBox x:Name="CarbsTextBox" Style="{StaticResource EditTextBox}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="2"
                            Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}">
                        <StackPanel>
                            <TextBlock Text="Связи и изображение" Style="{StaticResource EditBlockTitle}"/>

                            <TextBlock Text="Техкарта" Style="{StaticResource EditLabel}"/>
                            <TextBlock Text="Поиск техкарты"
                                       FontSize="16"
                                       Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="TechnicalCardSearchTextBox"
                                     Style="{StaticResource EditTextBox}"
                                     Margin="0,0,0,10"
                                     TextChanged="TechnicalCardSearchTextBox_TextChanged"/>
                            <ComboBox x:Name="TechnicalCardComboBox"
                                      Style="{StaticResource EditComboBox}"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"/>

                            <TextBlock Text="ImageUrl" Style="{StaticResource EditLabel}"/>
                            <TextBox x:Name="ImageUrlTextBox"
                                     Style="{StaticResource EditTextBox}"/>


                            <TextBlock x:Name="ValidationText"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="#FFB33131"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border Grid.Row="2"
                    BorderBrush="{StaticResource ModalColorBorderBrush}"
                    BorderThickness="0,2,0,0"
                    Padding="18"
                    Background="{StaticResource ModalColorWhiteBrush}">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Сохранить"
                            Width="180"
                            Margin="0,0,10,0"
                            Style="{StaticResource ModalPrimaryButton}"
                            Click="Save_Click"/>
                    <Button Content="Отмена"
                            Width="150"
                            Style="{StaticResource ModalSecondaryButton}"
                            Click="Cancel_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
