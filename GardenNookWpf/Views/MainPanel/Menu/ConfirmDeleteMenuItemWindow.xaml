<Window x:Class="GardenNookWpf.Views.MainPanel.Menu.ConfirmDeleteMenuItemWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление позиции меню"
        Width="760"
        Height="430"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Удаление позиции меню"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,12">
                <Border Style="{StaticResource ModalCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Удалить позицию меню?"
                                   Style="{StaticResource ModalBodyText}"
                                   FontSize="25"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="ItemNameText"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource ModalBodyText}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                        <TextBlock x:Name="ItemTypeText"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource ModalBodyText}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                   TextWrapping="Wrap"/>

                        <TextBlock Text="Если позиция уже используется в заказах или связях, сервер не позволит удалить её."
                                   Margin="0,14,0,0"
                                   Style="{StaticResource ModalBodyText}"
                                   FontSize="17"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="Удалить"
                        Width="180"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Background="#FF742C27"
                        Click="Confirm_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
