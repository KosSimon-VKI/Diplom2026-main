<Window x:Class="GardenNookWpf.Views.MainPanel.Clients.ClientCategoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Категория клиента"
        Width="680"
        Height="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Изменить категорию клиента"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="18,16,18,12"
                    Style="{StaticResource ModalCardBorder}">
                <StackPanel>
                    <TextBlock x:Name="ClientNameText"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource ModalColorTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ClientPhoneText"
                               Margin="0,5,0,16"
                               FontSize="18"
                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Категория"
                               FontSize="19"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModalColorTextBrush}"/>
                    <ComboBox x:Name="CategoryComboBox"
                              Height="44"
                              Margin="0,8,0,0"
                              FontSize="18"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"/>

                    <TextBlock x:Name="ValidationText"
                               Margin="0,12,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFB33131"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="Сохранить"
                        Width="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
