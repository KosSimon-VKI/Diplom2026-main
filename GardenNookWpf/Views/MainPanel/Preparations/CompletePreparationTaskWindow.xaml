                <TextBox x:Name="StockTextBox"
                         Grid.Row="3"
                         Margin="0,8,0,20"
                         Height="46"
                         FontSize="18"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Row="4"
                           Text="Р”Р°С‚Р° РёР·РіРѕС‚РѕРІР»РµРЅРёСЏ"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ModalColorTextBrush}"/>

                <DatePicker x:Name="ProductionDatePicker"
                            Grid.Row="5"
                            Margin="0,8,0,0"
                            Height="42"
                            FontSize="18"/>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="6"
                           Margin="0,14,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FFB33131"
                           Visibility="Collapsed"/>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="РџРѕРґС‚РІРµСЂРґРёС‚СЊ"
                        Width="190"
