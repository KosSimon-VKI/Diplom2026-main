<Window x:Class="GardenNookWpf.Views.MainPanel.Loyalty.ConfirmDeleteDiscountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удаление скидки"
        Width="700"
        Height="390"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Удаление скидки"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Margin="18,16,18,12"
                    Style="{StaticResource ModalCardBorder}">
                <StackPanel>
                    <TextBlock Text="Удалить скидку?"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModalColorTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DiscountNameText"
                               Margin="0,14,0,0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource ModalColorTextBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="DiscountDetailsText"
                               Margin="0,10,0,0"
                               FontSize="18"
                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="Если скидка использовалась в заказах, сервер запретит удаление."
                               Margin="0,14,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FF742C27"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="Удалить"
                        Width="150"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Background="#FF742C27"
                        Foreground="White"
                        Click="Confirm_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
