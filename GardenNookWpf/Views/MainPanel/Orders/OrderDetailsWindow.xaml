<Window x:Class="GardenNookWpf.Views.MainPanel.Orders.OrderDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа"
        Width="1080"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Детали заказа"
                                   Style="{StaticResource ModalHeaderTitle}"/>
                        <TextBlock x:Name="OrderHeaderText"
                                   Margin="0,2,0,0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ModalColorTextBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="?"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Style="{StaticResource ModalCardBorder}"
                        Background="{StaticResource ModalColorCardAltBrush}"
                        Padding="16,14">
                    <StackPanel>
                        <TextBlock x:Name="OrderMetaText"
                                   Style="{StaticResource ModalBodyText}"
                                   FontWeight="SemiBold"/>
                        <TextBlock x:Name="PickupAtTextBlock"
                                   Margin="0,8,0,0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="#FF2D5A27"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="OrderCommentTextBlock"
                                   Margin="0,8,0,0"
                                   FontSize="18"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource ModalColorTextBrush}"
                                   TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ItemsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Style="{StaticResource ModalCardBorder}"
                                            Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,12,0">
                                                <TextBlock Text="{Binding NameLine}"
                                                           FontSize="22"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ItemTypeText}"
                                                           Margin="0,5,0,0"
                                                           FontSize="15"
                                                           Foreground="#FF5A5A5A"/>
                                                <TextBlock Text="{Binding ToppingsLine}"
                                                           Margin="12,6,0,0"
                                                           FontSize="17"
                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Visibility="{Binding ToppingsVisibility}"/>
                                            </StackPanel>

                                            <Button Grid.Column="1"
                                                    Content="Тех. карта"
                                                    Width="132"
                                                    Margin="0,0,10,0"
                                                    Style="{StaticResource ModalSecondaryButton}"
                                                    Tag="{Binding}"
                                                    Click="ShowTechnicalCard_Click"/>

                                            <Button Grid.Column="2"
                                                    Content="Готово"
                                                    Width="116"
                                                    Style="{StaticResource ModalPrimaryButton}"
                                                    Tag="{Binding}"
                                                    Click="CompleteItem_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock x:Name="EmptyItemsText"
                               Text="Все позиции уже готовы"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource ModalColorTextBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button x:Name="CancelOrderButton"
                        Content="Отменить заказ"
                        Width="260"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalSecondaryButton}"
                        Visibility="Collapsed"
                        Click="CancelOrder_Click"/>
                <Button x:Name="CompleteOrderButton"
                        Content="Завершить заказ"
                        Width="320"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="CompleteOrder_Click"/>
                <Button Content="Закрыть"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

