<Window x:Class="GardenNookWpf.Views.MainPanel.Orders.OrderHistoryDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Детали заказа"
        Width="860"
        Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Детали заказа"
                                   Style="{StaticResource ModalHeaderTitle}"/>
                        <TextBlock x:Name="OrderTitleText"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource ModalColorTextBrush}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Style="{StaticResource ModalCardBorder}"
                        Background="{StaticResource ModalColorCardAltBrush}"
                        CornerRadius="10"
                        Padding="16">
                    <StackPanel>
                        <TextBlock x:Name="OrderMetaText"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModalColorTextBrush}"
                                   TextWrapping="Wrap"/>
                        <TextBlock x:Name="CommentText"
                                   FontSize="18"
                                   FontStyle="Italic"
                                   Foreground="{StaticResource ModalColorTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,12,0,0">
                    <ItemsControl x:Name="CompositionCards">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#FFD0DDC0"
                                        BorderThickness="1"
                                        Background="White"
                                        CornerRadius="8"
                                        Padding="12"
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="22"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Meta}"
                                                   FontSize="20"
                                                   Foreground="#FF5A5A5A"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Extra}"
                                                   FontSize="18"
                                                   Foreground="#FF4A6040"
                                                   TextWrapping="Wrap"
                                                   Margin="0,7,0,0"
                                                   Visibility="{Binding ExtraVisibility}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="Редактировать"
                        Width="190"
                        Style="{StaticResource ModalPrimaryButton}"
                        Margin="0,0,10,0"
                        Click="Edit_Click"/>
                <Button Content="Закрыть"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
