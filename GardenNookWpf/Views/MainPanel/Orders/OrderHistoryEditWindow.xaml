<Window x:Class="GardenNookWpf.Views.MainPanel.Orders.OrderHistoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать заказ"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowState="Maximized"
        WindowStyle="None"
        Background="White">
    <Border Style="{StaticResource ModalShellBorder}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="HeaderTitleText"
                               Style="{StaticResource ModalHeaderTitle}"
                               Text="Редактировать заказ"/>
                    <Button Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            HorizontalAlignment="Right"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <ContentControl x:Name="EditorHost" Grid.Row="1"/>
        </Grid>
    </Border>
</Window>
