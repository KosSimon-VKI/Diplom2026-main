<Window x:Class="GardenNookWpf.Views.MainPanel.Orders.OrderHistoryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактировать заказ"
        Width="1060"
        Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    <Window.Resources>
        <Style x:Key="EditOrderCardItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource ModalShellBorder}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <TextBlock x:Name="HeaderTitleText"
                               Style="{StaticResource ModalHeaderTitle}"
                               Text="Редактировать заказ"/>
                    <Button Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            HorizontalAlignment="Right"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18">
                <TabControl FontSize="18">
                    <TabItem Header="Данные заказа">
                        <Border Style="{StaticResource ModalCardBorder}"
                                Background="White"
                                CornerRadius="10"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                                    <TextBlock Text="Тип заказа" FontSize="18" FontWeight="Bold"/>
                                    <ComboBox x:Name="OrderTypeComboBox"
                                              Height="40"
                                              FontSize="18"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                                    <TextBlock Text="Статус" FontSize="18" FontWeight="Bold"/>
                                    <ComboBox x:Name="StatusComboBox"
                                              Height="40"
                                              FontSize="18"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                                    <TextBlock Text="Скидка" FontSize="18" FontWeight="Bold"/>
                                    <ComboBox x:Name="DiscountComboBox"
                                              Height="40"
                                              FontSize="18"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="Id"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,12">
                                    <TextBlock Text="Время самовывоза" FontSize="18" FontWeight="Bold"/>
                                    <TextBox x:Name="PickupAtTextBox"
                                             Height="40"
                                             FontSize="18"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                                    <TextBlock Text="Комментарий" FontSize="18" FontWeight="Bold"/>
                                    <TextBox x:Name="CommentTextBox"
                                             Height="120"
                                             FontSize="18"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Text="Формат времени самовывоза: 05.05.2026 18:30. Для заказа не с собой поле можно оставить пустым."
                                           FontSize="16"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Состав">
                        <Grid Margin="0,12,0,0">
                            <Border Style="{StaticResource ModalCardBorder}"
                                    Background="White"
                                    CornerRadius="10"
                                    Margin="0,0,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Позиции заказа"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10"/>
                                    <ScrollViewer Grid.Row="1"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">
                                        <ListBox x:Name="ItemsGrid"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 ItemContainerStyle="{StaticResource EditOrderCardItemStyle}"
                                                 SelectionChanged="ItemsGrid_SelectionChanged">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border BorderBrush="#FFD0DDC0"
                                                            BorderThickness="1"
                                                            Background="#FFFCFFFA"
                                                            CornerRadius="8"
                                                            Padding="10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="110"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding TypeDisplay}"
                                                                           FontSize="17"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource ModalColorPrimaryDarkBrush}"/>
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding ToppingsDisplay}"
                                                                           FontSize="17"
                                                                           Foreground="#FF4A6040"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,5,0,0"/>
                                                                <TextBlock Text="{Binding ModifiersDisplay}"
                                                                           FontSize="17"
                                                                           Foreground="#FF4A6040"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="Кол-во"
                                                                           FontSize="15"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"/>
                                                                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                                                                         Height="38"
                                                                         FontSize="18"
                                                                         TextAlignment="Center"
                                                                         VerticalContentAlignment="Center"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </ScrollViewer>
                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="210"/>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Выбранная позиция"
                                                   FontSize="20"
                                                   FontWeight="Bold"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="1"
                                                Content="Настроить добавки"
                                                Height="42"
                                                Margin="0,0,10,0"
                                                Style="{StaticResource ModalSecondaryButton}"
                                                Click="EditToppings_Click"/>
                                        <Button Grid.Column="2"
                                                Content="Удалить позицию"
                                                Height="42"
                                                Margin="0,0,10,0"
                                                Background="#FF742C27"
                                                Style="{StaticResource ModalPrimaryButton}"
                                                Click="RemoveItem_Click"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <ComboBox x:Name="MilkComboBox"
                                                      Width="0"
                                                      Height="0"
                                                      Visibility="Collapsed"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      SelectionChanged="Modifier_SelectionChanged"/>
                                            <ComboBox x:Name="CoffeeComboBox"
                                                      Width="0"
                                                      Height="0"
                                                      Visibility="Collapsed"
                                                      DisplayMemberPath="Name"
                                                      SelectedValuePath="Id"
                                                      SelectionChanged="Modifier_SelectionChanged"/>
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Добавить позицию">
                        <Border Style="{StaticResource ModalCardBorder}"
                                Background="White"
                                CornerRadius="10"
                                Margin="0,12,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="ItemTypeComboBox"
                                              Height="42"
                                              FontSize="18"
                                              Margin="0,0,10,0"
                                              SelectionChanged="ItemTypeComboBox_SelectionChanged"/>
                                    <TextBox x:Name="MenuSearchTextBox"
                                             Grid.Column="1"
                                             Height="42"
                                             FontSize="18"
                                             Margin="0,0,10,0"
                                             VerticalContentAlignment="Center"
                                             TextChanged="MenuSearchTextBox_TextChanged"/>
                                    <TextBox x:Name="QuantityTextBox"
                                             Grid.Column="2"
                                             Height="42"
                                             FontSize="18"
                                             Text="1"
                                             TextAlignment="Center"
                                             VerticalContentAlignment="Center"/>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="Меню"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Margin="0,0,0,10"/>

                                <ScrollViewer Grid.Row="2"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ListBox x:Name="MenuItemComboBox"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             DisplayMemberPath="Name"/>
                                </ScrollViewer>

                                <Button Grid.Row="3"
                                        Content="Добавить выбранную позицию"
                                        Height="46"
                                        Margin="0,12,0,0"
                                        Style="{StaticResource ModalPrimaryButton}"
                                        Click="AddItem_Click"/>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>
            </Grid>

            <Grid Grid.Row="2" Margin="18,0,18,18">
                <TextBlock x:Name="ValidationText"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FFB33131"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена"
                            Width="130"
                            Style="{StaticResource ModalSecondaryButton}"
                            Margin="0,0,10,0"
                            Click="Cancel_Click"/>
                    <Button Content="Сохранить"
                            Width="150"
                            Style="{StaticResource ModalPrimaryButton}"
                            Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
