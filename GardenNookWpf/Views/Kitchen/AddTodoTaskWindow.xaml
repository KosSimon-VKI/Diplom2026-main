<Window x:Class="GardenNookWpf.Views.Kitchen.AddTodoTaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить задачу"
        Width="760"
        Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Добавить задачу"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="✕"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,14,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="Текст задачи"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ModalColorTextBrush}"/>

                <TextBox x:Name="TaskTextBox"
                         Grid.Row="1"
                         Margin="0,8,0,16"
                         Height="46"
                         FontSize="18"
                         VerticalContentAlignment="Center"
                         MaxLength="255"/>

                <TextBlock Grid.Row="2"
                           Text="Комментарий"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ModalColorTextBrush}"/>

                <TextBox x:Name="CommentTextBox"
                         Grid.Row="3"
                         Margin="0,8,0,0"
                         FontSize="18"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         MaxLength="500"/>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="4"
                           Margin="0,10,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FFB33131"
                           Visibility="Collapsed"/>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button Content="Добавить"
                        Width="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Add_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
