<Window x:Class="GardenNookWpf.Views.Kitchen.TechnicalCardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Техкарта"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="HeaderTitle"
                               Style="{StaticResource ModalHeaderTitle}"/>

                    <Button Grid.Column="1"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0"
                            FontSize="19"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="Основное">
                        <Border Margin="0,12,0,0"
                                Padding="18"
                                Style="{StaticResource ModalCardBorder}"
                                Background="{StaticResource ModalColorCardAltBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0">
                                    <TextBlock Text="Название"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                    <TextBox x:Name="CardNameTextBox"
                                             Margin="0,8,0,0"
                                             Height="48"
                                             MaxLength="200"
                                             FontSize="18"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="Описание"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                    <TextBox x:Name="DescriptionTextBox"
                                             Margin="0,8,0,0"
                                             MinHeight="220"
                                             MaxLength="1000"
                                             FontSize="18"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Состав">
                        <Border Margin="0,12,0,0"
                                Padding="18"
                                Style="{StaticResource ModalCardBorder}"
                                Background="{StaticResource ModalColorCardAltBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="14"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Padding="12"
                                        Style="{StaticResource ModalCardBorder}"
                                        Background="{StaticResource ModalColorWhiteBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>

                                        <ComboBox x:Name="CompositionKindComboBox"
                                                  Height="44"
                                                  FontSize="17"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Kind"
                                                  SelectionChanged="CompositionKindComboBox_SelectionChanged"/>

                                        <ComboBox x:Name="CompositionItemComboBox"
                                                  Grid.Column="2"
                                                  Height="44"
                                                  FontSize="17"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"/>

                                        <Button Grid.Column="4"
                                                Content="Добавить строку"
                                                Style="{StaticResource ModalPrimaryButton}"
                                                FontSize="16"
                                                Click="AddCompositionLine_Click"/>
                                    </Grid>
                                </Border>

                                <DataGrid x:Name="CompositionLinesGrid"
                                          Grid.Row="2"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          RowHeight="42"
                                          FontSize="15"
                                          ItemsSource="{Binding CompositionLines}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Тип"
                                                            Binding="{Binding KindDisplay}"
                                                            IsReadOnly="True"
                                                            Width="95"/>
                                        <DataGridTextColumn Header="Позиция"
                                                            Binding="{Binding ItemName}"
                                                            IsReadOnly="True"
                                                            Width="*"/>
                                        <DataGridTemplateColumn Header="Ед. изм." Width="130">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=UnitOptions}"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Id"
                                                              SelectedValue="{Binding UnitOfMeasureId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Height="34"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Брутто"
                                                            Binding="{Binding GrossWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                                            Width="85"/>
                                        <DataGridTextColumn Header="Хол. %"
                                                            Binding="{Binding ColdLossPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                                            Width="75"/>
                                        <DataGridTextColumn Header="Нетто"
                                                            Binding="{Binding NetWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                                            Width="85"/>
                                        <DataGridTextColumn Header="Гор. %"
                                                            Binding="{Binding HotLossPercent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                                            Width="75"/>
                                        <DataGridTextColumn Header="Выход"
                                                            Binding="{Binding OutputWeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=0.##}"
                                                            Width="85"/>
                                        <DataGridTemplateColumn Width="110">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Удалить"
                                                            Style="{StaticResource ModalSecondaryButton}"
                                                            FontSize="14"
                                                            Height="32"
                                                            Padding="8,0"
                                                            Tag="{Binding}"
                                                            Click="RemoveCompositionLine_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>

                </TabControl>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="1"
                           Margin="0,12,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FFB33131"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="16,0,16,16">
                <Button x:Name="SaveButton"
                        Width="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Save_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
