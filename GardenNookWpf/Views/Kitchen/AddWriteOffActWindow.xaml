<Window x:Class="GardenNookWpf.Views.Kitchen.AddWriteOffActWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Создать акт списания"
        Width="1280"
        Height="820"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource ModalShellBorder}" Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource ModalHeader}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Создать акт списания"
                                   Style="{StaticResource ModalHeaderTitle}"/>
                        <TextBlock Text="Заполните данные акта, добавьте позиции и проверьте итоговый список"
                                   Margin="0,4,0,0"
                                   FontSize="16"
                                   Foreground="{StaticResource ModalColorTextBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,16,0">
                        <TextBlock Text="Дата акта:"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModalColorTextBrush}"/>
                        <TextBlock x:Name="ActDateText"
                                   Margin="8,0,0,0"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"/>
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="×"
                            Style="{StaticResource ModalCloseButton}"
                            Click="HeaderClose_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="18,16,18,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0"
                            FontSize="18"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="Добавление позиции">
                        <Border Margin="0,12,0,0"
                                Padding="18"
                                Style="{StaticResource ModalCardBorder}"
                                Background="{StaticResource ModalColorWhiteBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="14"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>
                                        <TextBlock Text="Что списываем"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"/>
                                        <ComboBox x:Name="LineKindComboBox"
                                                  Margin="0,8,0,0"
                                                  Height="44"
                                                  FontSize="16"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="Kind"
                                                  SelectionChanged="LineKindComboBox_SelectionChanged"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Поиск позиции"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"/>
                                        <TextBox x:Name="SearchTextBox"
                                                 Margin="0,8,0,0"
                                                 Height="44"
                                                 FontSize="16"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="SearchTextBox_TextChanged"/>
                                    </StackPanel>
                                </Grid>

                                <ListBox x:Name="ItemsListBox"
                                         Grid.Row="1"
                                         BorderBrush="{StaticResource ModalColorBorderBrush}"
                                         BorderThickness="2"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         SelectionChanged="ItemsListBox_SelectionChanged">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="8,6,14,6"
                                                    Padding="12"
                                                    Style="{StaticResource ModalCardBorder}"
                                                    Background="{StaticResource ModalColorCardAltBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding IdDisplay}"
                                                               Margin="0,2,0,0"
                                                               FontSize="14"
                                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                                    <TextBlock Text="{Binding AvailableDisplay}"
                                                               Margin="0,4,0,0"
                                                               FontSize="16"
                                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <Border Grid.Row="2"
                                        Margin="0,14,0,0"
                                        Padding="14"
                                        Style="{StaticResource ModalCardBorder}"
                                        Background="{StaticResource ModalColorCardAltBrush}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="AvailableText"
                                                   Grid.Row="0"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   TextWrapping="Wrap"/>

                                        <Grid Grid.Row="1" Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="190"/>
                                                <ColumnDefinition Width="14"/>
                                                <ColumnDefinition Width="190"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="Тип списания"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                                <ComboBox x:Name="WriteOffTypeComboBox"
                                                          Margin="0,8,0,0"
                                                          Height="44"
                                                          FontSize="16"
                                                          DisplayMemberPath="Name"
                                                          SelectedValuePath="WriteOffTypeId"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2">
                                                <TextBlock x:Name="QuantityLabel"
                                                           Text="Количество"
                                                           FontSize="18"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ModalColorTextBrush}"/>
                                                <TextBox x:Name="QuantityTextBox"
                                                         Margin="0,8,0,0"
                                                         Height="44"
                                                         FontSize="16"
                                                         VerticalContentAlignment="Center"/>
                                            </StackPanel>

                                            <Button Grid.Column="4"
                                                    Content="Добавить"
                                                    Height="44"
                                                    Margin="0,30,0,0"
                                                    Style="{StaticResource ModalPrimaryButton}"
                                                    Click="AddLine_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </TabItem>

                    <TabItem Header="Позиции акта">
                        <Border Margin="0,12,0,0"
                                Padding="18"
                                Style="{StaticResource ModalCardBorder}"
                                Background="{StaticResource ModalColorCardAltBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="Добавленные позиции"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"/>

                                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                        <TextBlock Text="Комментарий"
                                                   FontSize="18"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"/>
                                        <TextBox x:Name="CommentTextBox"
                                                 Margin="0,8,0,0"
                                                 MinHeight="82"
                                                 MaxHeight="110"
                                                 MaxLength="500"
                                                 FontSize="16"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                </Grid>

                                <ListBox x:Name="SelectedLinesListBox"
                                         Grid.Row="1"
                                         BorderBrush="{StaticResource ModalColorBorderBrush}"
                                         BorderThickness="2"
                                         HorizontalContentAlignment="Stretch"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="8,6,14,6"
                                                    Padding="12"
                                                    Style="{StaticResource ModalCardBorder}"
                                                    Background="{StaticResource ModalColorWhiteBrush}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Display}"
                                                               FontSize="18"
                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                               TextWrapping="Wrap"/>
                                                    <Button Grid.Column="1"
                                                            Content="Удалить"
                                                            Width="135"
                                                            MinWidth="135"
                                                            Height="38"
                                                            Margin="14,0,0,0"
                                                            Padding="8,0"
                                                            FontSize="16"
                                                            HorizontalContentAlignment="Center"
                                                            Style="{StaticResource ModalSecondaryButton}"
                                                            Tag="{Binding}"
                                                            Click="RemoveLine_Click"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </TabItem>
                </TabControl>

                <TextBlock x:Name="ValidationText"
                           Grid.Row="1"
                           Margin="0,12,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#FFB33131"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="18,0,18,18">
                <Button Content="Создать акт"
                        Width="190"
                        Margin="0,0,10,0"
                        Style="{StaticResource ModalPrimaryButton}"
                        Click="Create_Click"/>
                <Button Content="Отмена"
                        Width="140"
                        Style="{StaticResource ModalSecondaryButton}"
                        Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
