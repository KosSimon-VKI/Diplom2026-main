<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.StopList.StopListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="#fff">
                <Grid Margin="18,20,18,20">
                    <Border Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Стоп-лист"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ModalColorTextBrush}"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="AddPositionButton"
                                        Grid.Column="1"
                                        Content="Добавить позицию"
                                        Width="280"
                                        Height="50"
                                        Style="{StaticResource ModalPrimaryButton}"
                                        Click="AddPositionButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       Visibility="Collapsed"/>

                            <Grid Grid.Row="2"
                                  Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Поиск:"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>

                                <TextBox x:Name="SearchTextBox"
                                         Grid.Row="1"
                                         Margin="0,8,0,0"
                                         Height="42"
                                         FontSize="17"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchTextBox_TextChanged"/>
                            </Grid>

                            <Grid Grid.Row="3">
                                <ScrollViewer x:Name="PositionsScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="PositionsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10"
                                                        Style="{StaticResource ModalCardBorder}"
                                                        Background="{StaticResource ModalColorCardAltBrush}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Margin="0,0,16,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="24"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding ItemTypeDisplay}"
                                                                       Margin="0,6,0,0"
                                                                       FontSize="17"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"/>
                                                            <TextBlock Text="{Binding StateDisplay}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="16"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"/>
                                                            <TextBlock Text="{Binding CategoryDisplay}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="16"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       Visibility="{Binding CategoryVisibility}"/>
                                                            <TextBlock Text="{Binding ManualRemainingDisplay}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="15"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       Visibility="{Binding ManualRemainingVisibility}"/>
                                                            <TextBlock Text="{Binding AutoAvailableDisplay}"
                                                                       Margin="0,2,0,0"
                                                                       FontSize="15"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       Visibility="{Binding AutoAvailableVisibility}"/>
                                                            <TextBlock Text="{Binding EffectiveRemainingDisplay}"
                                                                       Margin="0,2,0,0"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       Visibility="{Binding EffectiveRemainingVisibility}"/>
                                                        </StackPanel>

                                                        <Button Grid.Column="1"
                                                                Width="280"
                                                                Height="46"
                                                                Content="Убрать из стоп-листа"
                                                                Style="{StaticResource ModalSecondaryButton}"
                                                                Tag="{Binding}"
                                                                Click="RemovePositionButton_Click"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="EmptyText"
                                           Text="Нет ограничений и позиций в стоп-листе."
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
    </Grid>
</UserControl>