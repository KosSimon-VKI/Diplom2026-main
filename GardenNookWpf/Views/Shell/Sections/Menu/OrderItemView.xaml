<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.Menu.OrderItemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="MenuTabItemStyle" TargetType="TabItem">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,8"/>
        </Style>

        <Style x:Key="MenuFilterButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalSecondaryButton}">
            <Setter Property="Height" Value="44"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="MenuSubcategoryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource ModalColorTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFB7B7B7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFEDF1E5"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource ModalColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuRoundIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ModalColorTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2B2B2B"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-2,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFEDF1E5"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource ModalColorPrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFD6DCCC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuAddButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource ModalColorTextBrush}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF2B2B2B"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFEDF1E5"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource ModalColorPrimaryDarkBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFD6DCCC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Background" Value="#FFEAECE6"/>
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#FFB0B4A8"/>
                                <Setter Property="Foreground" Value="#FF8C8E88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="White">
        <Viewbox x:Name="OrderScaleViewbox"
                 Stretch="Fill"
                 StretchDirection="Both">
            <Grid x:Name="ScaledContentGrid" Width="1200" Height="900">
                <Grid Margin="18,20,18,20">
                    <Border Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock x:Name="TitleText"
                                           Text="МЕНЮ"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ModalColorTextBrush}"
                                           HorizontalAlignment="Center"/>
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       Visibility="Collapsed"/>

                            <TabControl Grid.Row="2"
                                        x:Name="MenuTabs"
                                        FontSize="18"
                                        ItemContainerStyle="{StaticResource MenuTabItemStyle}">
                                <TabItem Header="МЕНЮ">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="300"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,14,0">
                                            <ScrollViewer x:Name="MenuScrollViewer"
                                                          VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled">
                                                <ItemsControl x:Name="MenuItemsList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                                    <Border Margin="0,0,0,12"
                                                                    Style="{StaticResource ModalCardBorder}"
                                                                    Background="{Binding CardBackground}"
                                                                    BorderBrush="{Binding CardBorderBrush}">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="150"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <Border Width="132"
                                                                            Height="132"
                                                                            BorderBrush="#FFD8D8D8"
                                                                            BorderThickness="2"
                                                                            CornerRadius="8"
                                                                            Background="#FFF0F0F0"
                                                                            VerticalAlignment="Top"
                                                                            Visibility="{Binding ImageVisibility}">
                                                                        <Image Source="{Binding ImageSource}"
                                                                               Stretch="UniformToFill"/>
                                                                    </Border>

                                                                    <Grid Grid.Column="1">
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>

                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="26"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                                       TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding SizeLabel}"
                                                                                       FontSize="24"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                                       Margin="12,0,0,0"/>
                                                                        </Grid>

                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="{Binding Category}"
                                                                                   FontSize="18"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                                   Margin="0,4,0,0"/>

                                                                        <TextBlock Grid.Row="2"
                                                                                   Text="{Binding PriceDisplay}"
                                                                                   FontSize="26"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                                   Margin="0,6,0,0"/>

                                                                        <TextBlock Grid.Row="3"
                                                                                   Text="{Binding DetailsDisplay}"
                                                                                   FontSize="20"
                                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,4,0,0"/>

                                                                        <TextBlock Grid.Row="4"
                                                                                   Text="{Binding IngredientsDisplay}"
                                                                                   FontSize="20"
                                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,5,0,0"
                                                                                   Visibility="{Binding IngredientsVisibility}"/>

                                                                        <Grid Grid.Row="5" Margin="0,10,0,0">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Orientation="Horizontal"
                                                                                        VerticalAlignment="Center">
                                                                                <TextBlock Text="Количество:"
                                                                                           FontSize="20"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                                           Visibility="{Binding QuantityVisibility}"/>
                                                                                <TextBlock Text="{Binding QuantityDisplay}"
                                                                                           FontSize="22"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                                           Margin="8,0,0,0"
                                                                                           Visibility="{Binding QuantityVisibility}"/>
                                                                                <TextBlock Text="Недоступно"
                                                                                           FontSize="17"
                                                                                           FontWeight="Bold"
                                                                                           Foreground="#FF742C27"
                                                                                           Margin="14,0,0,0"
                                                                                           Visibility="{Binding UnavailableVisibility}"/>
                                                                            </StackPanel>

                                                                            <Button Grid.Column="1"
                                                                                    Content="Добавить"
                                                                                    Style="{StaticResource MenuAddButtonStyle}"
                                                                                    Tag="{Binding}"
                                                                                    IsEnabled="{Binding IsAvailable}"
                                                                                    Click="AddMenuItemButton_Click"/>
                                                                        </Grid>
                                                                    </Grid>
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </ScrollViewer>

                                            <TextBlock x:Name="MenuEmptyText"
                                                       Text="Меню пусто"
                                                       FontSize="24"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Visibility="Collapsed"/>
                                        </Grid>

                                        <Border Grid.Column="1"
                                                BorderBrush="#FF6F6864"
                                                BorderThickness="2"
                                                CornerRadius="10"
                                                Padding="14,14,6,14"
                                                Background="#FFF9F9F9">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                          HorizontalScrollBarVisibility="Disabled"
                                                          Padding="0,0,12,0">
                                                <StackPanel Margin="0,0,4,0">
                                                    <TextBlock Text="Поиск:"
                                                               FontSize="19"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                                    <TextBox x:Name="SearchTextBox"
                                                             Height="42"
                                                             FontSize="18"
                                                             Margin="0,8,0,16"
                                                             VerticalContentAlignment="Center"
                                                             TextChanged="SearchTextBox_TextChanged"/>

                                                    <TextBlock Text="Фильтры"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <TextBlock Text="Цена:"
                                                               FontSize="18"
                                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                                    <Slider x:Name="PriceSlider"
                                                            Minimum="0"
                                                            Maximum="1000"
                                                            Value="1000"
                                                            TickFrequency="50"
                                                            Margin="0,8,0,0"
                                                            ValueChanged="PriceSlider_ValueChanged"/>
                                                    <TextBlock x:Name="PriceValueText"
                                                               Text="0 - 1000 ₽"
                                                               FontSize="18"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                               HorizontalAlignment="Center"
                                                               Margin="0,4,0,18"/>

                                                    <TextBlock Text="Категории"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                               Margin="0,0,0,10"/>
                                                    <Button x:Name="AllCategoryButton"
                                                            Content="Все"
                                                            Style="{StaticResource MenuFilterButtonStyle}"
                                                            Tag="all"
                                                            Click="MainCategoryButton_Click"/>
                                                    <Button x:Name="DishesCategoryButton"
                                                            Content="Блюда"
                                                            Style="{StaticResource MenuFilterButtonStyle}"
                                                            Tag="dishes"
                                                            Click="MainCategoryButton_Click"/>
                                                    <Button x:Name="DrinksCategoryButton"
                                                            Content="Напитки"
                                                            Style="{StaticResource MenuFilterButtonStyle}"
                                                            Tag="drinks"
                                                            Click="MainCategoryButton_Click"/>
                                                    <Button x:Name="ToppingsCategoryButton"
                                                            Content="Добавки"
                                                            Style="{StaticResource MenuFilterButtonStyle}"
                                                            Tag="toppings"
                                                            Click="MainCategoryButton_Click"/>

                                                    <TextBlock x:Name="SubcategoriesTitle"
                                                               Text="Подкатегории:"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                               Margin="0,10,0,8"
                                                               Visibility="Collapsed"/>
                                                    <ItemsControl x:Name="SubcategoriesList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Button Content="{Binding Name}"
                                                                        Style="{StaticResource MenuSubcategoryButtonStyle}"
                                                                        Background="{Binding Background}"
                                                                        Foreground="{Binding Foreground}"
                                                                        BorderBrush="{Binding BorderBrush}"
                                                                        Tag="{Binding}"
                                                                        Click="SubcategoryButton_Click"/>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </TabItem>

                                <TabItem x:Name="CartTabItem" Header="КОРЗИНА">
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.15*"/>
                                            <ColumnDefinition Width="0.85*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Style="{StaticResource ModalCardBorder}"
                                                Background="{StaticResource ModalColorWhiteBrush}"
                                                Margin="0,0,12,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <TextBlock Text="Товары"
                                                           FontSize="28"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,10"/>

                                                <ScrollViewer Grid.Row="1"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled">
                                                    <ItemsControl x:Name="CartItemsList">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource ModalColorPrimaryBrush}"
                                                                        BorderThickness="0,0,0,2"
                                                                        Padding="0,8"
                                                                        Margin="0,0,0,6">
                                                                    <Grid>
                                                                        <Grid.RowDefinitions>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                            <RowDefinition Height="Auto"/>
                                                                        </Grid.RowDefinitions>
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Text="{Binding NumberDisplay}"
                                                                                       FontSize="20"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                                       Margin="0,0,8,0"/>
                                                                            <TextBlock Grid.Column="1"
                                                                                       Text="{Binding Name}"
                                                                                       FontSize="20"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                                       TextWrapping="Wrap"/>
                                                                            <TextBlock Grid.Column="2"
                                                                                       Text="{Binding PriceDisplay}"
                                                                                       FontSize="20"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                                       Margin="10,0,0,0"/>
                                                                        </Grid>

                                                                        <TextBlock Grid.Row="1"
                                                                                   Text="{Binding DetailsDisplay}"
                                                                                   FontSize="17"
                                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="34,5,0,0"
                                                                                   Visibility="{Binding DetailsVisibility}"/>

                                                                        <StackPanel Grid.Row="2"
                                                                                    Orientation="Horizontal"
                                                                                    Margin="34,8,0,0">
                                                                            <Button Content="-"
                                                                                    Style="{StaticResource MenuRoundIconButtonStyle}"
                                                                                    Tag="{Binding}"
                                                                                    Click="DecreaseCartItemButton_Click"/>
                                                                            <TextBlock Text="{Binding Quantity}"
                                                                                       FontSize="20"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                                       VerticalAlignment="Center"
                                                                                       Margin="12,0"/>
                                                                            <Button Content="+"
                                                                                    Style="{StaticResource MenuRoundIconButtonStyle}"
                                                                                    Tag="{Binding}"
                                                                                    Click="IncreaseCartItemButton_Click"/>
                                                                            <Button Content="×"
                                                                                    Width="42"
                                                                                    Height="36"
                                                                                    FontSize="18"
                                                                                    Style="{StaticResource MenuRoundIconButtonStyle}"
                                                                                    Tag="{Binding}"
                                                                                    Margin="12,0,0,0"
                                                                                    Click="RemoveCartItemButton_Click"/>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>

                                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                                    <TextBlock x:Name="CartCaloriesText"
                                                               FontSize="22"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                               TextAlignment="Right"/>
                                                    <TextBlock x:Name="CartTotalBeforeDiscountText"
                                                               FontSize="20"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                               TextAlignment="Right"/>
                                                    <TextBlock x:Name="CartTotalText"
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                               TextAlignment="Right"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="1"
                                                Style="{StaticResource ModalCardBorder}"
                                                Background="{StaticResource ModalColorWhiteBrush}">
                                            <StackPanel>
                                                <TextBlock Text="Оформление"
                                                           FontSize="28"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,0,0,14"/>

                                                <TextBlock Text="Тип заказа:"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource ModalColorPrimaryDarkBrush}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,8,0,14">
                                                    <RadioButton x:Name="RestaurantOrderTypeRadio"
                                                                 Content="В ресторане"
                                                                 GroupName="OrderType"
                                                                 IsChecked="True"
                                                                 FontSize="20"
                                                                 Margin="0,0,18,0"
                                                                 Checked="OrderTypeRadio_Checked"/>
                                                    <RadioButton x:Name="TakeawayOrderTypeRadio"
                                                                 Content="С собой"
                                                                 GroupName="OrderType"
                                                                 FontSize="20"
                                                                 Checked="OrderTypeRadio_Checked"/>
                                                </StackPanel>

                                                <StackPanel x:Name="PickupSlotPanel" Visibility="Collapsed" Margin="0,0,0,14">
                                                    <TextBlock Text="Время самовывоза:"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"/>
                                                    <ComboBox x:Name="PickupSlotComboBox"
                                                              Height="42"
                                                              FontSize="19"
                                                              Margin="0,8,0,0"
                                                              DisplayMemberPath="Label"
                                                              SelectedValuePath="Value"/>
                                                    <TextBlock x:Name="PickupSlotNoteText"
                                                               FontSize="15"
                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                               TextWrapping="Wrap"
                                                               Margin="0,6,0,0"
                                                               Visibility="Collapsed"/>
                                                </StackPanel>

                                                <TextBlock Text="Скидка:"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource ModalColorPrimaryDarkBrush}"/>
                                                <ComboBox x:Name="DiscountComboBox"
                                                          Height="42"
                                                          FontSize="19"
                                                          Margin="0,8,0,14"
                                                          DisplayMemberPath="DisplayName"
                                                          SelectionChanged="DiscountComboBox_SelectionChanged"/>

                                                <TextBlock Text="Комментарий:"
                                                           FontSize="20"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource ModalColorPrimaryDarkBrush}"/>
                                                <TextBox x:Name="OrderCommentTextBox"
                                                         Height="112"
                                                         FontSize="18"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         Margin="0,8,0,14"/>

                                                <StackPanel x:Name="StatusPanel" Visibility="Collapsed" Margin="0,0,0,14">
                                                    <TextBlock Text="Статус:"
                                                               FontSize="20"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"/>
                                                    <ComboBox x:Name="StatusComboBox"
                                                              Height="42"
                                                              FontSize="19"
                                                              Margin="0,8,0,0"
                                                              DisplayMemberPath="Name"
                                                              SelectedValuePath="Id"/>
                                                </StackPanel>

                                                <Button x:Name="SubmitOrderButton"
                                                        Content="Оформить"
                                                        Height="50"
                                                        FontSize="22"
                                                        Style="{StaticResource ModalPrimaryButton}"
                                                        Click="SubmitOrderButton_Click"/>

                                                <TextBlock x:Name="OrderMessageText"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                           TextWrapping="Wrap"
                                                           Margin="0,12,0,0"
                                                           Visibility="Collapsed"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
