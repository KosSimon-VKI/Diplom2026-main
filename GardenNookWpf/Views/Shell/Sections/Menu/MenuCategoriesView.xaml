<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.Menu.MenuCategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="CategoryTypeButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalSecondaryButton}">
            <Setter Property="Width" Value="170"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="FontSize" Value="19"/>
        </Style>

        <Style x:Key="CategoryCardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalSecondaryButton}">
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="White">
                <Grid Margin="18,20,18,20">
                    <Border Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Категории меню"
                                       FontSize="34"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,14"/>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,12"
                                       Visibility="Collapsed"/>

                            <WrapPanel Grid.Row="2"
                                       Margin="0,0,0,14">
                                    <Button x:Name="DishesTypeButton"
                                            Content="Блюда"
                                            Tag="dishes"
                                            Style="{StaticResource CategoryTypeButtonStyle}"
                                            Click="TypeButton_Click"/>
                                    <Button x:Name="DrinksTypeButton"
                                            Content="Напитки"
                                            Tag="drinks"
                                            Style="{StaticResource CategoryTypeButtonStyle}"
                                            Click="TypeButton_Click"/>
                                    <Button x:Name="ToppingsTypeButton"
                                            Content="Добавки"
                                            Tag="toppings"
                                            Style="{StaticResource CategoryTypeButtonStyle}"
                                            Click="TypeButton_Click"/>

                                <Button x:Name="AddButton"
                                        Content="Добавить категорию"
                                        Width="230"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource ModalPrimaryButton}"
                                        Click="AddButton_Click"/>
                            </WrapPanel>

                            <Border Grid.Row="3"
                                    BorderBrush="#FF6F6864"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Padding="14"
                                    Background="#FFF9F9F9">
                                <Grid>
                                    <ScrollViewer x:Name="CategoriesScrollViewer"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0,0,12,0">
                                        <ItemsControl x:Name="CategoriesCardsList">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="170"
                                                            Margin="0,0,0,14"
                                                            HorizontalAlignment="Stretch"
                                                            Style="{StaticResource ModalCardBorder}"
                                                            Background="{StaticResource ModalColorWhiteBrush}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Text="{Binding Name}"
                                                                       FontSize="25"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       TextWrapping="Wrap"/>

                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding TypeDisplay}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                       Margin="0,6,0,0"/>

                                                            <Border Grid.Row="2"
                                                                    Margin="0,16,0,12"
                                                                    Background="#FFEDF1E5"
                                                                    BorderBrush="{StaticResource ModalColorPrimaryBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="12,8"
                                                                    HorizontalAlignment="Left">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="Позиций:"
                                                                               FontSize="18"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                                                    <TextBlock Text="{Binding ItemsCount}"
                                                                               FontSize="20"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                               Margin="8,0,0,0"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <StackPanel Grid.Row="3"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right">
                                                                <Button Content="Изменить"
                                                                        Style="{StaticResource CategoryCardActionButtonStyle}"
                                                                        Tag="{Binding}"
                                                                        Click="EditCategoryButton_Click"/>
                                                                <Button Content="Удалить"
                                                                        Style="{StaticResource CategoryCardActionButtonStyle}"
                                                                        Background="#FF742C27"
                                                                        Foreground="White"
                                                                        Tag="{Binding}"
                                                                        Click="DeleteCategoryButton_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock x:Name="EmptyText"
                                               Text="Категории не найдены"
                                               FontSize="24"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ModalColorTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
    </Grid>
</UserControl>
