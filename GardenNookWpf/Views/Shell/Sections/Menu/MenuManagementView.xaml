<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.Menu.MenuManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="FilterButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalSecondaryButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="White">
        <Viewbox Stretch="Fill" StretchDirection="Both">
            <Grid Width="1200" Height="900">
                <Grid Margin="18,20">
                    <Border Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="МЕНЮ"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ModalColorTextBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Добавить"
                                            Width="130"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource ModalPrimaryButton}"
                                            Click="AddButton_Click"/>
                                    <Button Content="Обновить"
                                            Width="130"
                                            Style="{StaticResource ModalSecondaryButton}"
                                            Click="RefreshButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0" Margin="0,0,14,0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <TextBox x:Name="SearchTextBox"
                                             Height="44"
                                             FontSize="18"
                                             Margin="0,0,0,12"
                                             VerticalContentAlignment="Center"
                                             TextChanged="SearchTextBox_TextChanged"/>

                                    <Grid Grid.Row="1">
                                        <ScrollViewer x:Name="ItemsScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="MenuItemsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,12"
                                                                Style="{StaticResource ModalCardBorder}"
                                                                Background="{Binding CardBackground}"
                                                                BorderBrush="{Binding CardBorderBrush}">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="25"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Subtitle}"
                                                                                   FontSize="17"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                                   TextWrapping="Wrap"
                                                                                   Margin="0,4,0,0"/>
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding PriceDisplay}"
                                                                               FontSize="24"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                                               Margin="14,0,0,0"/>
                                                                </Grid>

                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding DetailsDisplay}"
                                                                           FontSize="18"
                                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,8,0,0"/>

                                                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <TextBlock Text="{Binding AvailabilityDisplay}"
                                                                               FontSize="18"
                                                                               FontWeight="Bold"
                                                                               Foreground="{Binding AvailabilityBrush}"
                                                                               VerticalAlignment="Center"/>

                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                                        <Button Content="Изменить"
                                                                                Width="128"
                                                                                Height="42"
                                                                                Margin="0,0,8,0"
                                                                                Style="{StaticResource ModalSecondaryButton}"
                                                                                Tag="{Binding}"
                                                                                Click="EditItemButton_Click"/>
                                                                        <Button Content="Удалить"
                                                                                Width="118"
                                                                                Height="42"
                                                                                Style="{StaticResource ModalSecondaryButton}"
                                                                                Tag="{Binding}"
                                                                                Click="DeleteItemButton_Click"/>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock x:Name="EmptyText"
                                                   Text="Позиции меню не найдены."
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </Grid>

                                <Border Grid.Column="1"
                                        Style="{StaticResource ModalCardBorder}"
                                        Background="{StaticResource ModalColorCardBrush}">
                                    <StackPanel>
                                        <TextBlock Text="Фильтры"
                                                   FontSize="26"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,12"/>

                                        <Button x:Name="AllTypeButton"
                                                Content="Все"
                                                Tag="all"
                                                Style="{StaticResource FilterButtonStyle}"
                                                Click="TypeButton_Click"/>
                                        <Button x:Name="DishesTypeButton"
                                                Content="Блюда"
                                                Tag="dishes"
                                                Style="{StaticResource FilterButtonStyle}"
                                                Click="TypeButton_Click"/>
                                        <Button x:Name="DrinksTypeButton"
                                                Content="Напитки"
                                                Tag="drinks"
                                                Style="{StaticResource FilterButtonStyle}"
                                                Click="TypeButton_Click"/>
                                        <Button x:Name="ToppingsTypeButton"
                                                Content="Добавки"
                                                Tag="toppings"
                                                Style="{StaticResource FilterButtonStyle}"
                                                Click="TypeButton_Click"/>

                                        <TextBlock Text="Категория"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                   Margin="0,12,0,6"/>
                                        <ComboBox x:Name="CategoryFilterComboBox"
                                                  Height="42"
                                                  FontSize="17"
                                                  DisplayMemberPath="Name"
                                                  SelectedValuePath="Id"
                                                  SelectionChanged="CategoryFilterComboBox_SelectionChanged"/>

                                        <TextBlock Text="Доступность"
                                                   FontSize="18"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                   Margin="0,12,0,6"/>
                                        <ComboBox x:Name="AvailabilityFilterComboBox"
                                                  Height="42"
                                                  FontSize="17"
                                                  SelectionChanged="AvailabilityFilterComboBox_SelectionChanged">
                                            <ComboBoxItem Content="Все" Tag="all" IsSelected="True"/>
                                            <ComboBoxItem Content="Доступные" Tag="available"/>
                                            <ComboBoxItem Content="Недоступные" Tag="unavailable"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
