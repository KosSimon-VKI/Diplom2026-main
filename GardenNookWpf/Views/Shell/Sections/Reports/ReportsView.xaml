<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="ReportActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalSecondaryButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ReportSectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource ModalColorTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="White">
        <Border Margin="18,20"
                Style="{StaticResource ModalCardBorder}"
                Background="{StaticResource ModalColorWhiteBrush}"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="ОТЧЕТЫ"
                               FontSize="34"
                               FontWeight="Bold"
                               Foreground="{StaticResource ModalColorTextBrush}"
                               TextWrapping="Wrap"/>

                    <DockPanel Grid.Row="1"
                               LastChildFill="False"
                               Margin="0,10,0,0">
                        <WrapPanel x:Name="PeriodButtonsPanel"
                                   DockPanel.Dock="Left">
                            <Button Content="Неделя"
                                    Tag="week"
                                    Width="118"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource ReportActionButtonStyle}"
                                    Click="PeriodButton_Click"/>
                            <Button Content="Месяц"
                                    Tag="month"
                                    Width="118"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource ReportActionButtonStyle}"
                                    Click="PeriodButton_Click"/>
                            <Button Content="3 месяца"
                                    Tag="threeMonths"
                                    Width="132"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource ReportActionButtonStyle}"
                                    Click="PeriodButton_Click"/>
                            <Button Content="Полгода"
                                    Tag="halfYear"
                                    Width="126"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource ReportActionButtonStyle}"
                                    Click="PeriodButton_Click"/>
                            <Button Content="Все время"
                                    Tag="allTime"
                                    Width="140"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource ReportActionButtonStyle}"
                                    Click="PeriodButton_Click"/>
                        </WrapPanel>

                        <WrapPanel DockPanel.Dock="Right"
                                   HorizontalAlignment="Right">
                            <Button Content="Сформировать"
                                    Width="170"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource ModalPrimaryButton}"
                                    Click="RefreshButton_Click"/>
                            <Button Content="Сохранить Excel"
                                    Width="178"
                                    Margin="0,0,8,8"
                                    Style="{StaticResource ReportActionButtonStyle}"
                                    Click="ExportExcelButton_Click"/>
                            <Button Content="Сохранить PDF"
                                    Width="166"
                                    Margin="0,0,0,8"
                                    Style="{StaticResource ReportActionButtonStyle}"
                                    Click="ExportPdfButton_Click"/>
                        </WrapPanel>
                    </DockPanel>
                </Grid>

                <TextBlock x:Name="StatusText"
                           Grid.Row="1"
                           Margin="0,0,0,10"
                           FontSize="18"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,8,12"
                                    Style="{StaticResource ModalCardBorder}"
                                    Background="{StaticResource ModalColorCardBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="260"/>
                                        <RowDefinition Height="220"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="3 самые популярные позиции"
                                               Style="{StaticResource ReportSectionTitleStyle}"/>
                                    <lvc:CartesianChart x:Name="PopularChart"
                                                        Grid.Row="1"
                                                        LegendLocation="None"
                                                        Series="{Binding PopularSeries}">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding PopularLabels}"
                                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Продано"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                    <DataGrid x:Name="PopularGrid"
                                              Grid.Row="2"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ItemsSource="{Binding PopularItems}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Тип" Binding="{Binding ItemTypeName}" Width="110"/>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Продано" Binding="{Binding QuantityDisplay}" Width="100"/>
                                            <DataGridTextColumn Header="Выручка" Binding="{Binding RevenueDisplay}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <Border Grid.Column="1"
                                    Margin="8,0,0,12"
                                    Style="{StaticResource ModalCardBorder}"
                                    Background="{StaticResource ModalColorCardBrush}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="260"/>
                                        <RowDefinition Height="220"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="3 самые непопулярные позиции"
                                               Style="{StaticResource ReportSectionTitleStyle}"/>
                                    <lvc:CartesianChart x:Name="UnpopularChart"
                                                        Grid.Row="1"
                                                        LegendLocation="None"
                                                        Series="{Binding UnpopularSeries}">
                                        <lvc:CartesianChart.AxisX>
                                            <lvc:Axis Labels="{Binding UnpopularLabels}"
                                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                        </lvc:CartesianChart.AxisX>
                                        <lvc:CartesianChart.AxisY>
                                            <lvc:Axis Title="Продано"/>
                                        </lvc:CartesianChart.AxisY>
                                    </lvc:CartesianChart>
                                    <DataGrid x:Name="UnpopularGrid"
                                              Grid.Row="2"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              ItemsSource="{Binding UnpopularItems}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Тип" Binding="{Binding ItemTypeName}" Width="110"/>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Продано" Binding="{Binding QuantityDisplay}" Width="100"/>
                                            <DataGridTextColumn Header="Выручка" Binding="{Binding RevenueDisplay}" Width="110"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource ModalCardBorder}"
                                Background="{StaticResource ModalColorCardBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="300"/>
                                    <RowDefinition Height="360"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Инвентаризация"
                                           Style="{StaticResource ReportSectionTitleStyle}"/>
                                <lvc:CartesianChart x:Name="InventoryChart"
                                                    Grid.Row="1"
                                                    LegendLocation="Top"
                                                    Series="{Binding InventorySeries}">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Labels="{Binding InventoryLabels}"
                                                  Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Отклонение"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>

                                <DataGrid x:Name="InventoryGrid"
                                          Grid.Row="2"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          ItemsSource="{Binding InventoryItems}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Тип" Binding="{Binding ItemTypeName}" Width="130"/>
                                        <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Ед." Binding="{Binding UnitName}" Width="70"/>
                                        <DataGridTextColumn Header="Расход" Binding="{Binding ExpectedConsumptionDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="Факт" Binding="{Binding ActualStockDisplay}" Width="110"/>
                                        <DataGridTextColumn Header="Разница" Binding="{Binding DifferenceDisplay}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
