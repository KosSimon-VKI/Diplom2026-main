<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.WriteOff.WriteOffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid x:Name="RootGrid"
          Background="#fff">
                <Grid Margin="18,20,18,20">
                    <Border Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Акты списания"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ModalColorTextBrush}"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="AddActButton"
                                        Grid.Column="1"
                                        Content="Создать акт"
                                        Width="250"
                                        Height="50"
                                        Style="{StaticResource ModalPrimaryButton}"
                                        Click="AddActButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       Visibility="Collapsed"/>

                            <Grid Grid.Row="2"
                                  Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Поиск:"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"/>

                                <TextBox x:Name="SearchTextBox"
                                         Grid.Row="1"
                                         Margin="0,8,0,0"
                                         Height="42"
                                         FontSize="17"
                                         VerticalContentAlignment="Center"
                                         TextChanged="SearchTextBox_TextChanged"/>
                            </Grid>

                            <Grid Grid.Row="3">
                                <ScrollViewer x:Name="HistoryScrollViewer"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="HistoryList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,10"
                                                        Style="{StaticResource ModalCardBorder}"
                                                        Background="{StaticResource ModalColorCardAltBrush}"
                                                        BorderBrush="{StaticResource ModalColorPrimaryBrush}"
                                                        Padding="16">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding HeaderDisplay}"
                                                                       FontSize="24"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"/>

                                                            <Button Grid.Column="1"
                                                                    Content="Удалить"
                                                                    Width="150"
                                                                    Height="42"
                                                                    Margin="14,0,0,0"
                                                                    Style="{StaticResource ModalSecondaryButton}"
                                                                    Visibility="{Binding DeleteButtonVisibility}"
                                                                    Tag="{Binding}"
                                                                    Click="DeleteActButton_Click"/>
                                                        </Grid>

                                                        <StackPanel Grid.Row="1"
                                                                    Margin="0,10,0,0">
                                                            <TextBlock Text="{Binding CommentDisplay}"
                                                                       FontSize="17"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding StaffDisplay}"
                                                                       Margin="0,4,0,0"
                                                                       FontSize="17"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       TextWrapping="Wrap"/>
                                                        </StackPanel>

                                                        <Border Grid.Row="2"
                                                                Margin="0,12,0,10"
                                                                Height="1"
                                                                Background="{StaticResource ModalColorPrimaryBrush}"
                                                                Opacity="0.55"/>

                                                        <StackPanel Grid.Row="3">
                                                            <TextBlock Text="Состав акта:"
                                                                       FontSize="18"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                       Margin="0,0,0,8"/>
                                                            <ItemsControl ItemsSource="{Binding Lines}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Margin="0,0,0,8"
                                                                                Background="{StaticResource ModalColorWhiteBrush}"
                                                                                BorderBrush="{StaticResource ModalColorPrimaryBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="8"
                                                                                Padding="10,8">
                                                                            <TextBlock Text="{Binding Display}"
                                                                                       FontSize="17"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                                       TextWrapping="Wrap"/>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock x:Name="EmptyText"
                                           Text="История списаний пока пуста."
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ModalColorTextBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
    </Grid>
</UserControl>