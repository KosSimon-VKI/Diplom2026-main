<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.Inventory.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="InventoryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalSecondaryButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="White">
                <Grid Margin="18,20">
                    <Border Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="СЫРЬЕ И ПОЛУФАБРИКАТЫ"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ModalColorTextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>

                                <WrapPanel Grid.Row="1"
                                           HorizontalAlignment="Right"
                                           Margin="0,8,0,0">
                                    <Button x:Name="SupplyButton"
                                            Content="Поставка"
                                            Width="145"
                                            Margin="0,0,10,8"
                                            Style="{StaticResource ModalSecondaryButton}"
                                            Click="SupplyButton_Click"/>
                                    <Button x:Name="AddButton"
                                            Content="Добавить сырье"
                                            Width="210"
                                            Style="{StaticResource ModalPrimaryButton}"
                                            Click="AddButton_Click"/>
                                </WrapPanel>
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Row="2"
                                     Height="44"
                                     Margin="0,0,0,12"
                                     FontSize="18"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>

                            <TabControl x:Name="InventoryTabs"
                                        Grid.Row="3"
                                        SelectionChanged="InventoryTabs_SelectionChanged">
                                <TabItem Header="Сырье">
                                    <Grid Margin="0,12,0,0">
                                        <ScrollViewer x:Name="IngredientsScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="IngredientsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,12"
                                                                Style="{StaticResource ModalCardBorder}"
                                                                Background="White">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="26"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Subtitle}"
                                                                                   FontSize="18"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                                   Margin="0,4,0,0"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding CostDisplay}"
                                                                               FontSize="26"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                                               Margin="14,0,0,0"/>
                                                                </Grid>

                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding DetailsDisplay}"
                                                                           FontSize="20"
                                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,8,0,0"/>

                                                                <StackPanel Grid.Row="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            Margin="0,12,0,0">
                                                                    <Button Content="Изменить"
                                                                            Width="128"
                                                                            Margin="0,0,8,0"
                                                                            Style="{StaticResource InventoryActionButtonStyle}"
                                                                            Tag="{Binding}"
                                                                            Click="EditIngredientButton_Click"/>
                                                                    <Button Content="Удалить"
                                                                            Width="118"
                                                                            Style="{StaticResource InventoryActionButtonStyle}"
                                                                            Background="#FF742C27"
                                                                            Foreground="White"
                                                                            Tag="{Binding}"
                                                                            Click="DeleteIngredientButton_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock x:Name="EmptyIngredientsText"
                                                   Text="Сырье не найдено."
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Полуфабрикаты">
                                    <Grid Margin="0,12,0,0">
                                        <ScrollViewer x:Name="SemiFinishedScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="SemiFinishedList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,12"
                                                                Style="{StaticResource ModalCardBorder}"
                                                                Background="White">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="26"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding Subtitle}"
                                                                                   FontSize="18"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                                   Margin="0,4,0,0"
                                                                                   TextWrapping="Wrap"/>
                                                                    </StackPanel>

                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding CostDisplay}"
                                                                               FontSize="26"
                                                                               FontWeight="Bold"
                                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                                               Margin="14,0,0,0"/>
                                                                </Grid>

                                                                <TextBlock Grid.Row="1"
                                                                           Text="{Binding DetailsDisplay}"
                                                                           FontSize="20"
                                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,8,0,0"/>

                                                                <StackPanel Grid.Row="2"
                                                                            Orientation="Horizontal"
                                                                            HorizontalAlignment="Right"
                                                                            Margin="0,12,0,0">
                                                                    <Button Content="Изменить"
                                                                            Width="128"
                                                                            Margin="0,0,8,0"
                                                                            Style="{StaticResource InventoryActionButtonStyle}"
                                                                            Tag="{Binding}"
                                                                            Click="EditSemiFinishedButton_Click"/>
                                                                    <Button Content="Удалить"
                                                                            Width="118"
                                                                            Style="{StaticResource InventoryActionButtonStyle}"
                                                                            Background="#FF742C27"
                                                                            Foreground="White"
                                                                            Tag="{Binding}"
                                                                            Click="DeleteSemiFinishedButton_Click"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock x:Name="EmptySemiFinishedText"
                                                   Text="Полуфабрикаты не найдены."
                                                   FontSize="22"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
    </Grid>
</UserControl>
