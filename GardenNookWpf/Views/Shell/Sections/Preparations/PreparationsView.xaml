<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.Preparations.PreparationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="PreparationsTabItemStyle"
               TargetType="TabItem">
            <Setter Property="FontSize"
                    Value="24"/>
            <Setter Property="Padding"
                    Value="26,10"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          Background="#fff">
        <Viewbox Stretch="Fill"
                 StretchDirection="Both">
            <Grid Width="1200"
                  Height="900">
                <Grid Margin="18,20,18,20">
                    <Border Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0"
                                  Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button x:Name="AddTodoTaskButton"
                                            Content="Добавить задачу"
                                            Width="360"
                                            Height="50"
                                            Margin="0,0,10,0"
                                            Style="{StaticResource ModalSecondaryButton}"
                                            Click="AddTodoTaskButton_Click"/>
                                    <Button x:Name="AddTaskButton"
                                            Content="Добавить полуфабрикат"
                                            Width="300"
                                            Height="50"
                                            Style="{StaticResource ModalPrimaryButton}"
                                            Click="AddTaskButton_Click"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       Foreground="{StaticResource ModalColorTextBrush}"
                                       Visibility="Collapsed"/>

                            <TabControl Grid.Row="2"
                                        FontSize="18"
                                        ItemContainerStyle="{StaticResource PreparationsTabItemStyle}">
                                <TabItem Header="Задачи">
                                    <Grid Margin="0,10,0,0">
                                        <ScrollViewer x:Name="TasksScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="TasksList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,10"
                                                                Style="{StaticResource ModalCardBorder}"
                                                                Background="{StaticResource ModalColorCardAltBrush}"
                                                                Cursor="Hand"
                                                                Tag="{Binding}"
                                                                MouseLeftButtonUp="TaskCard_MouseLeftButtonUp">
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <StackPanel Grid.Column="0"
                                                                                Margin="0,0,12,0">
                                                                        <TextBlock Text="{Binding TaskText}"
                                                                                   FontSize="23"
                                                                                   FontWeight="Bold"
                                                                                   Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding SemiFinishedDisplay}"
                                                                                   Margin="0,4,0,0"
                                                                                   FontSize="16"
                                                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                                                   Visibility="{Binding SemiFinishedVisibility}"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock Text="{Binding CreatedAtText}"
                                                                                   Margin="0,4,0,0"
                                                                                   FontSize="15"
                                                                                   Foreground="#FF6B6B6B"/>
                                                                    </StackPanel>

                                                                    <StackPanel Grid.Column="1">
                                                                        <Button x:Name="CompleteTaskButton"
                                                                                Width="290"
                                                                                Content="Отметить выполненным"
                                                                                Style="{StaticResource ModalPrimaryButton}"
                                                                                Visibility="{Binding CompleteButtonVisibility}"
                                                                                Tag="{Binding}"
                                                                                Click="CompleteTask_Click"/>
                                                                        <Button x:Name="DeleteTaskButton"
                                                                                Width="290"
                                                                                Margin="0,8,0,0"
                                                                                Content="Удалить"
                                                                                Style="{StaticResource ModalSecondaryButton}"
                                                                                Visibility="{Binding DeleteButtonVisibility}"
                                                                                Tag="{Binding}"
                                                                                Click="DeleteTask_Click"/>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <TextBlock Grid.Row="1"
                                                                           Margin="0,12,0,0"
                                                                           FontSize="18"
                                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                                           Text="{Binding CommentDisplay}"
                                                                           TextWrapping="Wrap"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock x:Name="EmptyTasksText"
                                                   Text="Список заготовок к приготовлению пуст"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </TabItem>

                                <TabItem Header="Заготовки">
                                    <Grid Margin="0,10,0,0">
                                        <ScrollViewer x:Name="ExistingScrollViewer"
                                                      VerticalScrollBarVisibility="Auto"
                                                      HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl x:Name="ExistingList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Margin="0,0,0,10"
                                                                Style="{StaticResource ModalCardBorder}"
                                                                BorderBrush="{Binding BorderBrush}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0"
                                                                            Margin="0,0,14,0">
                                                                    <TextBlock Text="{Binding PreparationName}"
                                                                               FontSize="23"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{StaticResource ModalColorTextBrush}"
                                                                               TextWrapping="Wrap"/>
                                                                    <TextBlock Text="{Binding StockText}"
                                                                               Margin="0,8,0,0"
                                                                               FontSize="18"
                                                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                                                    <TextBlock Text="{Binding ProductionDateText}"
                                                                               Margin="0,4,0,0"
                                                                               FontSize="18"
                                                                               Foreground="{StaticResource ModalColorTextBrush}"/>
                                                                </StackPanel>

                                                                <Button Grid.Column="1"
                                                                        Width="180"
                                                                        Content="Удалить"
                                                                        Style="{StaticResource ModalSecondaryButton}"
                                                                        Tag="{Binding PreparationId}"
                                                                        Click="DeleteExistingPreparation_Click"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>

                                        <TextBlock x:Name="EmptyExistingText"
                                                   Text="Готовые заготовки отсутствуют"
                                                   FontSize="24"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Visibility="Collapsed"/>
                                    </Grid>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
