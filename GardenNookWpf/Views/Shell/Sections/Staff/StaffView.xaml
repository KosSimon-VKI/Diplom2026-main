<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.Staff.StaffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="StaffCardActionButtonStyle" TargetType="Button" BasedOn="{StaticResource ModalSecondaryButton}">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="White">
                <Grid Margin="18,20">
                    <Border Style="{StaticResource ModalCardBorder}"
                            Background="{StaticResource ModalColorWhiteBrush}"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="ПЕРСОНАЛ"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource ModalColorTextBrush}"
                                           TextWrapping="Wrap"
                                           VerticalAlignment="Center"/>

                                <Button x:Name="AddButton"
                                        Grid.Column="1"
                                        Content="Добавить"
                                        Width="150"
                                        Style="{StaticResource ModalPrimaryButton}"
                                        Click="AddButton_Click"/>
                            </Grid>

                            <TextBlock x:Name="StatusText"
                                       Grid.Row="1"
                                       Margin="0,0,0,10"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       Visibility="Collapsed"/>

                            <TextBox x:Name="SearchTextBox"
                                     Grid.Row="2"
                                     Height="44"
                                     FontSize="18"
                                     Margin="0,0,0,12"
                                     VerticalContentAlignment="Center"
                                     TextChanged="SearchTextBox_TextChanged"/>

                            <Border Grid.Row="3"
                                    BorderBrush="#FF6F6864"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Padding="14"
                                    Background="#FFF9F9F9">
                                <Grid>
                                    <ScrollViewer x:Name="StaffScrollViewer"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  Padding="0,0,12,0">
                                        <ItemsControl x:Name="StaffList">
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border MinHeight="150"
                                                            Margin="0,0,0,12"
                                                            HorizontalAlignment="Stretch"
                                                            Style="{StaticResource ModalCardBorder}"
                                                            Background="{StaticResource ModalColorWhiteBrush}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Text="{Binding FullName}"
                                                                       FontSize="26"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource ModalColorTextBrush}"
                                                                       TextWrapping="Wrap"/>

                                                            <StackPanel Grid.Row="1"
                                                                        Margin="0,12,0,0">
                                                                <TextBlock Text="{Binding RoleDisplay}"
                                                                           FontSize="19"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource ModalColorPrimaryDarkBrush}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock Text="{Binding LoginDisplay}"
                                                                           Margin="0,5,0,0"
                                                                           FontSize="18"
                                                                           Foreground="{StaticResource ModalColorTextBrush}"
                                                                           TextWrapping="Wrap"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Row="2"
                                                                        Margin="0,12,0,0"
                                                                        Orientation="Horizontal"
                                                                        HorizontalAlignment="Right">
                                                                <Button Content="Изменить"
                                                                        Width="128"
                                                                        Margin="0,0,8,0"
                                                                        Style="{StaticResource StaffCardActionButtonStyle}"
                                                                        Tag="{Binding}"
                                                                        Click="EditStaffButton_Click"/>
                                                                <Button Content="Удалить"
                                                                        Width="118"
                                                                        Style="{StaticResource StaffCardActionButtonStyle}"
                                                                        Background="#FF742C27"
                                                                        Foreground="White"
                                                                        Tag="{Binding}"
                                                                        Click="DeleteStaffButton_Click"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock x:Name="EmptyText"
                                               Text="Сотрудники не найдены."
                                               FontSize="22"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ModalColorTextBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
    </Grid>
</UserControl>
