<UserControl x:Class="GardenNookWpf.Views.Shell.Sections.OrderHistory.OrderHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="OrderHistoryCardStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Background="#FFF5F5F5">
        <Grid Margin="18,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="ИСТОРИЯ ЗАКАЗОВ"
                       FontSize="34"
                       FontWeight="Bold"
                       Foreground="{StaticResource ModalColorTextBrush}"
                       Margin="0,0,0,14"/>

            <Border Grid.Row="1"
                    Style="{StaticResource ModalCardBorder}"
                    Background="White"
                    CornerRadius="10"
                    Padding="12"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchTextBox"
                             Height="42"
                             FontSize="18"
                             Margin="0,0,10,0"
                             TextChanged="Filter_Changed"
                             VerticalContentAlignment="Center"/>
                    <ComboBox x:Name="StatusFilterComboBox"
                              Grid.Column="1"
                              Height="42"
                              FontSize="18"
                              Margin="0,0,10,0"
                              SelectionChanged="Filter_Changed"/>
                    <ComboBox x:Name="PeriodFilterComboBox"
                              Grid.Column="2"
                              Height="42"
                              FontSize="18"
                              DisplayMemberPath="Title"
                              SelectionChanged="PeriodFilter_Changed"/>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Style="{StaticResource ModalCardBorder}"
                    Background="White"
                    CornerRadius="10"
                    Padding="12">
                <ListBox x:Name="OrdersList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemContainerStyle="{StaticResource OrderHistoryCardStyle}"
                         SelectionChanged="OrdersList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="8,2,2,2"
                                    BorderBrush="{Binding StatusBorderBrush}"
                                    Background="{Binding StatusBackgroundBrush}"
                                    CornerRadius="10"
                                    Padding="10"
                                    Cursor="Hand">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="20"
                                                   FontWeight="ExtraBold"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <Border Grid.Column="1"
                                                BorderBrush="{Binding StatusAccentBrush}"
                                                Background="{Binding StatusBadgeBrush}"
                                                BorderThickness="2"
                                                CornerRadius="20"
                                                Padding="12,4"
                                                Margin="12,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="10"
                                                         Height="10"
                                                         Fill="{Binding StatusAccentBrush}"
                                                         VerticalAlignment="Center"
                                                         Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Status}"
                                                           FontSize="16"
                                                           FontWeight="Bold"
                                                           Foreground="{Binding StatusAccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1"
                                               Text="{Binding MetaDisplay}"
                                               FontSize="18"
                                               Foreground="#FF555555"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"/>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding TotalDisplay}"
                                               FontSize="18"
                                               FontWeight="SemiBold"
                                               Foreground="#FF555555"
                                               Margin="0,3,0,0"/>

                                    <Border Grid.Row="3"
                                            BorderBrush="#FFC7D8A7"
                                            BorderThickness="0,1,0,0"
                                            Margin="0,8,0,0"
                                            Padding="0,6,0,0">
                                        <TextBlock Text="{Binding CompositionSummary}"
                                                   FontSize="18"
                                                   Foreground="{StaticResource ModalColorTextBrush}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <TextBlock x:Name="StatusText"
                       Grid.Row="3"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource ModalColorTextBrush}"
                       TextWrapping="Wrap"
                       Margin="0,12,0,0"
                       Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>
