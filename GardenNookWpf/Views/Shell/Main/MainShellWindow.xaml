<Window x:Class="GardenNookWpf.Views.Shell.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Garden Nook"
        Width="1500"
        Height="900"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Icon="/Images/logo.png">

    <Window.Resources>
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="Foreground" Value="#FF474747"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavigationColumn" Width="460"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Background="#FF91A56E"
              Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="16,16,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MenuToggleButton"
                        Content="☰"
                        Style="{StaticResource RoundedButton}"
                        Width="64"
                        Height="56"
                        FontSize="24"
                        Padding="0"
                        Click="MenuToggleButton_Click"/>

                <TextBlock x:Name="MenuTitleText"
                           Grid.Column="1"
                           Text="Разделы"
                           Foreground="White"
                           FontSize="30"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"/>
            </Grid>

            <WrapPanel x:Name="NavigationButtonsPanel"
                       Grid.Row="1"
                       Margin="8,0,8,16">
                <Button x:Name="OrdersButton"
                        Content="Заказы"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="OrdersButton_Click"/>

                <Button x:Name="TechCardsButton"
                        Content="Тех. карты"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="TechCardsButton_Click"/>

                <Button x:Name="PreparationsButton"
                        Content="Заготовки"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="PreparationsButton_Click"/>

                <Button x:Name="StopListButton"
                        Content="Стоп-лист"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="StopListButton_Click"/>

                <Button x:Name="WriteOffButton"
                        Content="Акты списания"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="WriteOffButton_Click"/>

                <Button x:Name="MenuItemsButton"
                        Content="Создание заказа"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="MenuItemsButton_Click"/>

                <Button x:Name="MenuManagementButton"
                        Content="Меню"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="MenuManagementButton_Click"/>

                <Button x:Name="ProductCategoriesButton"
                        Content="Категории меню"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="18"
                        FontWeight="Bold"
                        Click="ProductCategoriesButton_Click"/>

                <Button x:Name="InventoryButton"
                        Content="Склад"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="InventoryButton_Click"/>

                <Button x:Name="IngredientCategoriesButton"
                        Content="Категории сырья"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="18"
                        FontWeight="Bold"
                        Click="IngredientCategoriesButton_Click"/>

                <Button x:Name="OrderHistoryButton"
                        Content="История заказов"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="18"
                        FontWeight="Bold"
                        Click="OrderHistoryButton_Click"/>

                <Button x:Name="ClientsButton"
                        Content="Клиенты"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="ClientsButton_Click"/>

                <Button x:Name="LoyaltyButton"
                        Content="Лояльность"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="LoyaltyButton_Click"/>

                <Button x:Name="ReportsButton"
                        Content="Отчеты"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="ReportsButton_Click"/>

                <Button x:Name="StaffButton"
                        Content="Персонал"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="StaffButton_Click"/>

                <Button x:Name="BackButton"
                        Content="Выйти"
                        Style="{StaticResource RoundedButton}"
                        Width="206"
                        Height="64"
                        Margin="8,7"
                        FontSize="22"
                        FontWeight="Bold"
                        Click="BackButton_Click"/>
            </WrapPanel>
        </Grid>

        <Border Grid.Column="1"
                Background="White">
            <ContentControl x:Name="SectionHost"/>
        </Border>
    </Grid>
</Window>
